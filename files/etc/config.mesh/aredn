
config downloads
        option firmwarepath 'http://downloads.arednmesh.org/firmware'

config poe
        option passthrough '0'

config usb
        option passthrough '1'

config map
        option leafletjs 'http://unpkg.com/leaflet@0.7.7/dist/leaflet.js'
        option leafletcss 'http://unpkg.com/leaflet@0.7.7/dist/leaflet.css'
        option maptiles 'http://stamen-tiles-{s}.a.ssl.fastly.net/terrain/{z}/{x}/{y}.jpg'

config dmz
        option mode '3'

config tunnel
        option weight '1'

config lqm

config watchdog
        option enable '0'

config wireless_watchdog
        option enable '1'
        option daily '03:00'

# Multi-WAN remains opt-in. The primary AREDN WAN is unchanged until enabled.
# The calibration endpoint is populated by image/deployment configuration and
# is never accepted from a browser request.
config multiwan 'multiwan'
        option enabled '0'
        option active 'wan'
        option wan3_enable '0'
        option wan3_device 'auto'
        option wan3_proxy_enable '1'
        option wan3_proxy_host '192.168.49.1'
        option wan3_proxy_port '8000'
        option wan3_proxy_username ''
        option wan3_proxy_password ''
        option wan3_proxy_local_port '12345'
        option calibration_provider 'Hurricane Electric / Hayward Internet Exchange'
        option calibration_host ''
        option calibration_url ''
        option calibration_cooldown '300'
