#!/bin/sh /etc/rc.common
# Manage the optional AREDN USB WAN after the base network is available.

START=96
STOP=10

start()
{
    # The package-provided service owns /etc/redsocks.conf and normally uses
    # port 12345. AREDN uses a separate generated configuration and PID file.
    /etc/init.d/redsocks stop >/dev/null 2>&1 || true
    /usr/local/bin/wan3-manager apply >/dev/null 2>&1 || true
}

stop()
{
    /usr/local/bin/wan3-manager remove >/dev/null 2>&1 || true
}

reload()
{
    /etc/init.d/redsocks stop >/dev/null 2>&1 || true
    /usr/local/bin/wan3-manager apply >/dev/null 2>&1 || true
}
