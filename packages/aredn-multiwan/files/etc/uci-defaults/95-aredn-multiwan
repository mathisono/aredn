#!/bin/sh
# Seed package defaults without modifying the base firmware source file.

UCI="uci -c /etc/config.mesh"

if ! $UCI -q get aredn.multiwan >/dev/null 2>&1; then
    $UCI batch <<'EOF'
set aredn.multiwan='multiwan'
set aredn.multiwan.enabled='0'
set aredn.multiwan.active='wan'
set aredn.multiwan.wan3_enable='0'
set aredn.multiwan.wan3_device='auto'
set aredn.multiwan.wan3_proxy_enable='1'
set aredn.multiwan.wan3_proxy_host='192.168.49.1'
set aredn.multiwan.wan3_proxy_port='8000'
set aredn.multiwan.wan3_proxy_username=''
set aredn.multiwan.wan3_proxy_password=''
set aredn.multiwan.wan3_proxy_local_port='12346'
set aredn.multiwan.calibration_provider='Hurricane Electric / Hayward Internet Exchange'
set aredn.multiwan.calibration_host=''
set aredn.multiwan.calibration_url=''
set aredn.multiwan.calibration_cooldown='300'
EOF
else
    set_default()
    {
        option="$1"
        value="$2"
        $UCI -q get "aredn.multiwan.$option" >/dev/null 2>&1 || \
            $UCI set "aredn.multiwan.$option=$value"
    }

    set_default enabled 0
    set_default active wan
    set_default wan3_enable 0
    set_default wan3_device auto
    set_default wan3_proxy_enable 1
    set_default wan3_proxy_host 192.168.49.1
    set_default wan3_proxy_port 8000
    set_default wan3_proxy_username ''
    set_default wan3_proxy_password ''
    set_default wan3_proxy_local_port 12346
    set_default calibration_provider 'Hurricane Electric / Hayward Internet Exchange'
    set_default calibration_host ''
    set_default calibration_url ''
    set_default calibration_cooldown 300

    # Development builds before the installable package used the feed package's
    # example listener port. Move only that known old default to our private port.
    if [ "$($UCI -q get aredn.multiwan.wan3_proxy_local_port 2>/dev/null)" = 12345 ]; then
        $UCI set aredn.multiwan.wan3_proxy_local_port='12346'
    fi
fi

$UCI commit aredn
exit 0