#!/bin/sh
# Re-evaluate local WANs and tunnel policy after netifd events.

[ "$(uci -c /etc/config.mesh -q get aredn.multiwan.enabled 2>/dev/null)" = 1 ] || exit 0

case "${INTERFACE:-}" in
    wan|wan2|wan3)
        # Stock 11-meshrouting may have just restored WAN1 in table 28. While
        # PollyWAN is enabled, invalidate all default-like exports before any
        # asynchronous health decision can run.
        ip -4 route flush table 28 default >/dev/null 2>&1 || true
        ip -4 route flush table 28 0.0.0.0/1 >/dev/null 2>&1 || true
        ip -4 route flush table 28 128.0.0.0/1 >/dev/null 2>&1 || true
        /usr/local/bin/wan-route-cache "$INTERFACE" >/dev/null 2>&1 || true
        /usr/local/bin/wan3-manager route-event "$INTERFACE" "${ACTION:-}" >/dev/null 2>&1 &
        ;;
    wg*|tun*)
        /usr/local/bin/wan-tunnel-guard apply >/dev/null 2>&1 &
        ;;
esac
