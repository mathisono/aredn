{%
import * as pollywan from "aredn.pollywan";

const supportedBoards = {
    "mikrotik,routerboard-952ui-5ac2nd": true,
    "mikrotik,hap-ac2": true,
    "mikrotik,hap-ac3": true
};
if (!auth.isAdmin) { response.statusCode = 403; print("Administrator authentication required"); return; }
if (!supportedBoards[hardware.getBoardModel().id]) { response.statusCode = 404; print("Ethernet role management is not available on this device"); return; }

function readJson(path)
{
    const value = fs.readfile(path);
    if (!value) return null;
    try { return json(value); } catch (_) { return null; }
}
function role(value)
{
    return value === "lan" || value === "wan" || value === "wan2" || value === "off" ? value : "off";
}
function wifiWanInfo()
{
    const radio0 = uciMesh.get("setup", "globals", "radio0_mode") || "";
    const radio1 = uciMesh.get("setup", "globals", "radio1_mode") || "";
    const conflict = radio0 === "wan" && radio1 === "wan";
    if (conflict) return { active: false, conflict: true, device: "", label: "invalid: both radios are WAN clients" };
    if (radio0 === "wan") return { active: true, conflict: false, device: "wlan0", label: "Wi-Fi client on wlan0" };
    if (radio1 === "wan") return { active: true, conflict: false, device: "wlan1", label: "Wi-Fi client on wlan1" };
    return { active: false, conflict: false, device: "br-wan", label: "Ethernet br-wan" };
}
function loadPorts()
{
    const result = [];
    const f = fs.popen("/usr/local/bin/wan-port-manager ports 2>/dev/null");
    if (f) {
        for (let line = f.read("line"); length(line); line = f.read("line")) {
            const p = split(trim(line), "|");
            if (length(p) === 6) push(result, { name: p[0], label: p[1], device: p[2], active: p[3] === "1", role: p[4], dtd: p[5] === "1" });
        }
        f.close();
    }
    return result;
}
function loadXlinks()
{
    const xlinks = [];
    uciMesh.foreach("xlink", "interface", x => {
        let port = "";
        const ports = uciMesh.get("xlink", `${x[".name"]}bridge`, "ports") || [];
        if (length(ports)) {
            const m = match(ports[0], /^(.+):/);
            if (m) port = m[1];
        }
        push(xlinks, {
            name: x[".name"],
            vlan: int(split(x.ifname || "br0.0", ".")[1]),
            ipaddr: x.ipaddr || "",
            cost: x.cost ? int(x.cost) : "",
            port: port,
            cidr: network.netmaskToCIDR(x.netmask || "255.255.255.255"),
            note: x.note || ""
        });
    });
    return xlinks;
}
function normalizedXlinks(raw)
{
    const xs = json(raw || "[]");
    const normalized = [];
    const seen = {};
    for (let i = 0; i < length(xs); i++) {
        const ux = xs[i];
        const vlan = int(ux.vlan);
        const cidr = int(ux.cidr);
        const cost = ux.cost == null || ux.cost === "" ? null : int(ux.cost);
        if (!match(ux.name || "", /^xlink[0-9]+$/) || seen[ux.name]) die("invalid XLink name");
        if (vlan < 4 || vlan > 4095 || cidr < 16 || cidr > 32) die("invalid XLink network");
        if (!match(ux.ipaddr || "", constants.reIP)) die("invalid XLink address");
        if (cost != null && (cost < 0 || cost > 9999)) die("invalid XLink cost");
        seen[ux.name] = true;
        push(normalized, {
            name: ux.name,
            vlan: vlan,
            ipaddr: ux.ipaddr,
            cidr: cidr,
            netmask: network.CIDRToNetmask(cidr),
            cost: cost,
            port: ux.port || "",
            note: ux.note || ""
        });
    }
    return normalized;
}

const wifiWan = wifiWanInfo();
const controllerEnabled = uciMesh.get("aredn", "multiwan", "enabled") === "1";
const wanEnabled = uciMesh.get("aredn", "multiwan", "wan_enable") !== "0";
const wan2Enabled = uciMesh.get("aredn", "multiwan", "wan2_enable") === "1";
let message = "";
let error = "";
let applyStarted = false;
if (request.env.REQUEST_METHOD === "PUT") {
    const action = request.args.action || "apply";
    if (action === "apply") {
        const roles = {};
        let lanCount = 0;
        let wanCount = 0;
        let wan2Count = 0;
        for (let i = 1; i <= 5; i++) {
            const name = `port${i}`;
            const selected = role(request.args[`role_${name}`] || uciMesh.get("aredn", "multiwan", `${name}_role`) || "off");
            roles[name] = selected;
            if (selected === "lan") lanCount++;
            else if (selected === "wan") wanCount++;
            else if (selected === "wan2") wan2Count++;
        }
        if (wifiWan.conflict) error = "Both radios are configured as WAN clients. AREDN supports only one radio owning logical WAN 1.";
        else if (lanCount < 1) error = "At least one Ethernet port must remain LAN";
        else if (wifiWan.active && wanCount > 0) error = `WAN 1 is ${wifiWan.label}; no Ethernet port may also be assigned to WAN 1`;
        else if (!wifiWan.active && wanEnabled && wanCount < 1) error = "WAN 1 is enabled but no port is assigned to WAN 1";
        else if (wan2Enabled && wan2Count < 1) error = "WAN 2 is enabled but no port is assigned to WAN 2";
        else {
            /* Internal ownership follows the Route Policy master enable.  The
             * Ports page owns assignments, never a second enable switch. */
            const values = { port_roles_enabled: controllerEnabled ? "1" : "0" };
            for (let i = 1; i <= 5; i++) {
                const name = `port${i}`;
                values[`${name}_role`] = roles[name];
                values[`${name}_dtd`] = request.args[`dtd_${name}`] === "on" ? "1" : "0";
            }
            let staged = false;
            const stageRc = system("/usr/local/bin/wan-port-manager stage >/tmp/wan-port-manager/stage.log 2>&1");
            if (stageRc !== 0) error = "Could not preserve the current Ethernet configuration for rollback";
            else staged = true;
            if (!error) {
                const saved = pollywan.save("ports", values, uciMesh);
                if (!saved.ok) {
                    if (staged) system("/usr/local/bin/wan-port-manager restore-stage >/dev/null 2>&1");
                    error = saved.error;
                }
                else {
                    if (hardware.supportsFeature("xlink")) {
                        try {
                            const persistentXlinks = pollywan.saveXlinks(normalizedXlinks(request.args.xlinks || "[]"), {
                                port: length(hardware.getEthernetPorts()) ? hardware.getEthernetPorts()[0].k : "eth0",
                                cost: uciMesh.get("babel", "xlink", "rxcost")
                            }, uciMesh);
                            if (!persistentXlinks.ok) error = persistentXlinks.error;
                        }
                        catch (_) { error = "XLinks contain invalid persistent configuration values"; }
                    }
                    if (error) system("/usr/local/bin/wan-port-manager restore-stage >/dev/null 2>&1");
                }
                if (!error && !controllerEnabled) {
                    if (system("/usr/local/bin/wan-port-manager abort-stage >/dev/null 2>&1") !== 0)
                        error = "Assignments were saved, but the temporary rollback snapshot could not be cleared";
                    else
                        message = "Port and XLink assignments saved and verified; they will take effect when PollyWAN is enabled";
                }
                else if (!error) {
                    const validateRc = system("/usr/local/bin/wan-port-manager validate >/tmp/wan-port-manager/apply.log 2>&1");
                    if (validateRc !== 0) {
                        system("/usr/local/bin/wan-port-manager restore-stage >/dev/null 2>&1");
                        const detail = trim(fs.readfile("/tmp/wan-port-manager/apply.log") || "");
                        error = detail || "The saved Ethernet role configuration did not pass validation";
                    }
                    else if (system("/usr/local/bin/wan-port-manager apply >/tmp/wan-port-manager/apply.log 2>&1 &") !== 0) {
                        system("/usr/local/bin/wan-port-manager restore-stage >/dev/null 2>&1");
                        error = "Ethernet roles were saved and verified, but the apply operation could not be started";
                    }
                    else {
                        applyStarted = true;
                        message = "Ethernet roles were saved and verified; apply started. Reconnect and confirm within the rollback window.";
                    }
                }
            }
        }
    }
    else if (action === "confirm") {
        const token = request.args.token || "";
        if (!match(token, /^[0-9]+-[0-9]+$/)) error = "No valid rollback token is available";
        else if (system(`/usr/local/bin/wan-port-manager confirm ${token} >/dev/null 2>&1`) === 0) message = "Ethernet role change confirmed";
        else error = "Could not confirm the Ethernet role change";
    }
    else error = "Invalid Ethernet role action";
}
if (request.env.REQUEST_METHOD === "DELETE") {
    configuration.revertModalChanges();
    print(_R("changes"));
    return;
}
if (message && !applyStarted) configuration.prepareModalChanges();

const ports = loadPorts();
const ethPorts = hardware.getEthernetPorts();
const haveXlinks = hardware.supportsFeature("xlink");
const xlinks = loadXlinks();
const defxcost = uciMesh.get("babel", "xlink", "rxcost");
const state = readJson("/tmp/wan-port-manager/state.json");
const roleEnabled = uciMesh.get("aredn", "multiwan", "port_roles_enabled") === "1";
const rolesApplied = roleEnabled && fs.access("/etc/aredn_include/.aredn-multiwan-ports");
%}
<div class="dialog pollywan-dialog pollywan-ports-page">
    {{_R("dialog-header", "Ports &amp; XLinks")}}
    <div>
        {% if (error) { %}<div class="pw-notice pw-notice-error"><b>{{error}}</b></div>{% } else if (message) { %}<div class="pw-notice pw-notice-ok">{{message}}</div>{% } %}
        <div class="cols"><div><div class="o">State</div><div class="m">{{state && state.message || "No managed Ethernet roles have been applied"}}</div></div><div style="flex:0;text-align:right"><div>{{rolesApplied ? "Managed" : "AREDN defaults"}}</div><div class="m">{{state && state.pending_token ? "confirmation required" : controllerEnabled ? "PollyWAN enabled" : "PollyWAN disabled"}}</div></div></div>
        {% if (roleEnabled && !rolesApplied && !applyStarted && !(state && state.pending_token)) { %}<div class="pw-notice pw-notice-error"><b>Ethernet role management is saved as enabled but its managed files are not active. Reconciliation will apply the saved roles or disable the flag and report an error.</b></div>{% } %}
        <form id="ethernet-role-form">
            <div class="ports pollywan-ports-table-wrap"><div><table><thead><tr><td></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; %}<td class="{{p.active ? "active" : ""}}"><div>{{p.label}}</div><div>{{p.device}}</div></td>{% } %}</tr></thead><tbody>
                <tr><td><div>DtD</div><div>VLAN 2</div></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; %}<td><input type="checkbox" name="dtd_{{p.name}}" {{p.dtd ? "checked" : ""}}></td>{% } %}</tr>
                <tr><td><div>LAN</div><div>untagged</div></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; %}<td><input type="radio" name="role_{{p.name}}" value="lan" {{p.role === "lan" ? "checked" : ""}}></td>{% } %}</tr>
                {% if (!wifiWan.active) { %}<tr><td><div>WAN 1</div><div>untagged</div></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; %}<td><input type="radio" name="role_{{p.name}}" value="wan" {{p.role === "wan" ? "checked" : ""}}></td>{% } %}</tr>{% } %}
                <tr><td><div>WAN 2</div><div>untagged</div></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; %}<td><input type="radio" name="role_{{p.name}}" value="wan2" {{p.role === "wan2" ? "checked" : ""}}></td>{% } %}</tr>
                <tr><td><div>Off</div><div>untagged</div></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; const off = p.role === "off" || (wifiWan.active && p.role === "wan"); %}<td><input type="radio" name="role_{{p.name}}" value="off" {{off ? "checked" : ""}}></td>{% } %}</tr>
            </tbody></table></div></div>
        </form>
        {{_H("Assign one untagged role to each Ethernet port. DtD VLAN 2 may also be tagged on any port. Active links are green.")}}
        {% if (haveXlinks) { %}
        <hr>
        <div class="xlinks">
            <div class="cols"><div><div class="o">XLinks</div><div class="m">Normal AREDN XLinks across non-AREDN networks. They are not Internet WAN candidates.</div></div><button class="add" type="button">+</button></div>
            <form id="xlink-form">
                <textarea name="xlinks" hidden>{{sprintf("%J", xlinks)}}</textarea>
                <div id="xlink-list" class="pollywan-xlinks-wrap">
                    <div class="xlink-label adr"><div><div>vlan</div><div>ip a&zwnj;ddress</div><div>cidr</div><div>cost</div><div>port</div><div>note</div></div><div></div></div>
                    {% for (let i = 0; i < length(xlinks); i++) { const x = xlinks[i]; %}
                    <div class="xlink adr" data-name="{{x.name}}"><div>
                        <input name="vlan" type="text" size="5" required pattern="([4-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5])" placeholder="VLan" value="{{x.vlan}}">
                        <input name="ipaddr" type="text" size="25" required pattern="{{constants.patIP}}" placeholder="IP A&zwnj;ddress" value="{{x.ipaddr}}">
                        <select name="cidr">{% for (let cidr = 32; cidr >= 16; cidr--) { %}<option value="{{cidr}}" {{x.cidr === cidr ? "selected" : ""}}>{{cidr === 32 ? "PtP" : "/ " + cidr}}</option>{% } %}</select>
                        <input name="cost" type="text" size="4" pattern="([0-9]|[1-9][0-9]{1,3})" placeholder="{{defxcost}}" value="{{x.cost}}">
                        <select name="port">{% for (let j = 0; j < length(ethPorts); j++) { const p = ethPorts[j]; %}<option value="{{p.k}}" {{x.port === p.k ? "selected" : ""}}>{{p.d}}</option>{% } %}</select>
                        <input name="note" type="text" placeholder="Note" value="{{x.note}}">
                    </div><button type="button">-</button></div>
                    {% } %}
                </div>
            </form>
        </div>
        {{_H("XLinks route AREDN traffic across external non-AREDN networks.")}}
        {% } %}
        <div class="pw-actions pw-ethernet-role-actions"><button type="button" id="apply-ports" hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-include="#ethernet-role-form{{haveXlinks ? ',#xlink-form' : ''}}" hx-vals='{"action":"apply"}'>Apply</button>{% if (state && state.pending_token) { %}<button type="button" hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-vals='{"action":"confirm","token":"{{state.pending_token}}"}'>Confirm</button>{% } %}</div>
    </div>
    {{_R("dialog-footer", applyStarted ? "nocancel" : "")}}
    <script>(function(){
        {{_R("open")}}
        const patIP = "((25[0-5]|(2[0-4]|1[0-9]|[1-9]|)[0-9])\\.?\\b){4}";
        const xlinks = {{sprintf("%J", xlinks)}};
        function syncXlinks() {
            const field = htmx.find("#ctrl-modal .dialog #xlink-form [name=xlinks]");
            if (field) field.value = JSON.stringify(xlinks);
        }
        function updateXlinkModel(target) {
            const xlink = xlinks.find(x => x.name == target.dataset.name);
            if (!xlink) return;
            xlink.vlan = parseInt(htmx.find(target, "[name=vlan]").value);
            xlink.ipaddr = htmx.find(target, "[name=ipaddr]").value;
            const cost = htmx.find(target, "[name=cost]").value;
            xlink.cost = cost ? parseInt(cost) : null;
            xlink.port = htmx.find(target, "[name=port]").value;
            xlink.cidr = parseInt(htmx.find(target, "[name=cidr]").value);
            xlink.note = htmx.find(target, "[name=note]").value || "";
        }
        htmx.on("#ctrl-modal .dialog #xlink-list", "change", event => {
            if (!htmx.closest(htmx.find("#ctrl-modal .dialog #xlink-list"), "form").checkValidity()) return;
            const target = htmx.closest(event.target, "[data-name]");
            if (target) updateXlinkModel(target);
            syncXlinks();
        });
        htmx.on("#ctrl-modal .dialog #xlink-list", "click", event => {
            if (event.target.nodeName !== "BUTTON") return;
            const target = htmx.closest(event.target, "[data-name]");
            const index = xlinks.findIndex(x => x.name == target.dataset.name);
            if (index >= 0) xlinks.splice(index, 1);
            htmx.remove(target);
            syncXlinks();
        });
        function newXlinkEntry() {
            let name;
            for (let i = 0;; i++) {
                name = `xlink${i}`;
                if (!htmx.find(`#ctrl-modal .dialog #xlink-list .xlink[data-name=${name}]`)) break;
            }
            xlinks.push({ name: name, vlan: "", ipaddr: "", cost: null, port: null, cidr: 32, note: "" });
            const div = document.createElement("div");
            div.innerHTML = `<div class="xlink adr" data-name="${name}"><div>
<input name="vlan" type="text" size="5" required pattern="([4-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5])" placeholder="VLan">
<input name="ipaddr" type="text" size="25" required pattern="${patIP}" placeholder="IP A&zwnj;ddress">
<select name="cidr"><option value="32">PtP</option><option value="31">/ 31</option><option value="30">/ 30</option><option value="29">/ 29</option><option value="28">/ 28</option><option value="27">/ 27</option><option value="26">/ 26</option><option value="25">/ 25</option><option value="24">/ 24</option><option value="23">/ 23</option><option value="22">/ 22</option><option value="21">/ 21</option><option value="20">/ 20</option><option value="19">/ 19</option><option value="18">/ 18</option><option value="17">/ 17</option><option value="16">/ 16</option></select>
<input name="cost" type="text" size="4" pattern="([0-9]|[1-9][0-9]{1,3})" placeholder="{{defxcost}}">
<select name="port">{% for (let j = 0; j < length(ethPorts); j++) { const p = ethPorts[j]; %}<option value="{{p.k}}">{{p.d}}</option>{% } %}</select>
<input name="note" type="text" placeholder="Note"></div><button type="button">-</button></div>`;
            const entry = div.firstChild;
            htmx.find("#ctrl-modal .dialog #xlink-list").appendChild(entry);
            htmx.find(entry, "input").focus();
            syncXlinks();
        }
        htmx.on("#ctrl-modal .dialog .xlinks .add", "click", newXlinkEntry);
        htmx.on("#ctrl-modal .dialog #apply-ports", "click", event => {
            const form = htmx.find("#ctrl-modal .dialog #xlink-form");
            if (form && !form.checkValidity()) { form.reportValidity(); event.preventDefault(); event.stopImmediatePropagation(); return; }
            for (const entry of htmx.findAll("#ctrl-modal .dialog #xlink-list .xlink")) updateXlinkModel(entry);
            syncXlinks();
        });
        htmx.on("#dialog-done", "click", _ => htmx.ajax("GET", "/a/u-ethernet-ports", { target: "#ethernet-ports", swap: "outerHTML" }));
    })();</script>
</div>
