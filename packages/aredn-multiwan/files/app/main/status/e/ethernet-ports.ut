{%
const supportedBoards = {
    "mikrotik,routerboard-952ui-5ac2nd": true,
    "mikrotik,hap-ac2": true,
    "mikrotik,hap-ac3": true
};
if (!auth.isAdmin) { response.statusCode = 403; print("Administrator authentication required"); return; }
if (!supportedBoards[hardware.getBoardModel().id]) { response.statusCode = 404; print("Ethernet role management is not available on this device"); return; }

function readJson(path)
{
    const value = fs.readfile(path);
    if (!value) return null;
    try { return json(value); } catch (_) { return null; }
}
function role(value)
{
    return value === "lan" || value === "wan" || value === "wan2" || value === "off" ? value : "off";
}
function wifiWanInfo()
{
    const radio0 = uciMesh.get("setup", "globals", "radio0_mode") || "";
    const radio1 = uciMesh.get("setup", "globals", "radio1_mode") || "";
    const conflict = radio0 === "wan" && radio1 === "wan";
    if (conflict) return { active: false, conflict: true, device: "", label: "invalid: both radios are WAN clients" };
    if (radio0 === "wan") return { active: true, conflict: false, device: "wlan0", label: "Wi-Fi client on wlan0" };
    if (radio1 === "wan") return { active: true, conflict: false, device: "wlan1", label: "Wi-Fi client on wlan1" };
    return { active: false, conflict: false, device: "br-wan", label: "Ethernet br-wan" };
}
function loadPorts()
{
    const result = [];
    const f = fs.popen("/usr/local/bin/wan-port-manager ports 2>/dev/null");
    if (f) {
        for (let line = f.read("line"); length(line); line = f.read("line")) {
            const p = split(trim(line), "|");
            if (length(p) === 6) push(result, { name: p[0], label: p[1], device: p[2], active: p[3] === "1", role: p[4], dtd: p[5] === "1" });
        }
        f.close();
    }
    return result;
}
function loadXlinks()
{
    const xlinks = [];
    uciMesh.foreach("xlink", "interface", x => {
        let port = "";
        const ports = uciMesh.get("xlink", `${x[".name"]}bridge`, "ports") || [];
        if (length(ports)) {
            const m = match(ports[0], /^(.+):/);
            if (m) port = m[1];
        }
        push(xlinks, {
            name: x[".name"],
            vlan: int(split(x.ifname || "br0.0", ".")[1]),
            ipaddr: x.ipaddr || "",
            cost: x.cost ? int(x.cost) : "",
            port: port,
            cidr: network.netmaskToCIDR(x.netmask || "255.255.255.255"),
            note: x.note || ""
        });
    });
    return xlinks;
}
function saveXlinks(raw)
{
    const xs = json(raw || "[]");
    const xlinks = {};
    for (let i = 0; i < length(xs); i++) xlinks[xs[i].name] = xs[i];
    let defport = "eth0";
    const ports = hardware.getEthernetPorts();
    if (length(ports) > 0) defport = ports[0].k;
    const defxcost = uciMesh.get("babel", "xlink", "rxcost");
    const ucixlinks = {};
    uciMesh.foreach("xlink", "interface", x => { ucixlinks[x[".name"]] = true; });
    for (let name in ucixlinks) {
        const ux = xlinks[name];
        if (ux) {
            uciMesh.set("xlink", `${name}bridge`, "vlan", ux.vlan);
            uciMesh.set("xlink", `${name}bridge`, "ports", [ `${ux.port || defport}:t` ]);
            uciMesh.set("xlink", name, "ifname", `br0.${ux.vlan}`);
            uciMesh.set("xlink", name, "ipaddr", ux.ipaddr);
            uciMesh.set("xlink", name, "cost", ux.cost ?? defxcost);
            uciMesh.set("xlink", name, "netmask", network.CIDRToNetmask(ux.cidr));
            uciMesh.set("xlink", name, "note", ux.note || "");
            delete xlinks[name];
        }
        else {
            uciMesh.delete("xlink", name);
            uciMesh.delete("xlink", `${name}bridge`);
            uciMesh.delete("xlink", `${name}route`);
        }
    }
    for (let name in xlinks) {
        const ux = xlinks[name];
        uciMesh.set("xlink", `${ux.name}bridge`, "bridge-vlan");
        uciMesh.set("xlink", `${ux.name}bridge`, "device", "br0");
        uciMesh.set("xlink", `${ux.name}bridge`, "vlan", ux.vlan);
        uciMesh.set("xlink", `${ux.name}bridge`, "ports", [ `${ux.port || defport}:t` ]);
        uciMesh.set("xlink", name, "interface");
        uciMesh.set("xlink", name, "ifname", `br0.${ux.vlan}`);
        uciMesh.set("xlink", name, "ipaddr", ux.ipaddr);
        uciMesh.set("xlink", name, "cost", ux.cost ?? defxcost);
        uciMesh.set("xlink", name, "netmask", network.CIDRToNetmask(ux.cidr));
        uciMesh.set("xlink", name, "note", ux.note || "");
        uciMesh.set("xlink", name, "proto", "static");
        uciMesh.set("xlink", name, "macaddr", replace("x2:xx:xx:xx:xx:xx", "x", _ => sprintf("%X", math.rand() & 15)));
    }
    uciMesh.commit("xlink");
}

const wifiWan = wifiWanInfo();
let message = "";
let error = "";
if (request.env.REQUEST_METHOD === "PUT") {
    const action = request.args.action || "save";
    if (action === "save-xlinks") {
        configuration.prepareChanges();
        saveXlinks(request.args.xlinks);
        message = "XLinks saved using the normal AREDN xlink configuration";
    }
    else if (action === "save" || action === "apply") {
        const roles = {};
        let lanCount = 0;
        let wanCount = 0;
        let wan2Count = 0;
        for (let i = 1; i <= 5; i++) {
            const name = `port${i}`;
            const selected = role(request.args[`role_${name}`] || uciMesh.get("aredn", "multiwan", `${name}_role`) || "off");
            roles[name] = selected;
            if (selected === "lan") lanCount++;
            else if (selected === "wan") wanCount++;
            else if (selected === "wan2") wan2Count++;
        }
        const wanEnabled = request.args.wan_enable === "on";
        const wan2Enabled = request.args.wan2_enable === "on";
        if (wifiWan.conflict) error = "Both radios are configured as WAN clients. AREDN supports only one radio owning logical WAN 1.";
        else if (lanCount < 1) error = "At least one Ethernet port must remain LAN";
        else if (wifiWan.active && wanCount > 0) error = `WAN 1 is ${wifiWan.label}; no Ethernet port may also be assigned to WAN 1`;
        else if (!wifiWan.active && wanEnabled && wanCount < 1) error = "WAN 1 is enabled but no port is assigned to WAN 1";
        else if (wan2Enabled && wan2Count < 1) error = "WAN 2 is enabled but no port is assigned to WAN 2";
        else {
            uciMesh.set("aredn", "multiwan", "port_roles_enabled", request.args.port_roles_enabled === "on" ? "1" : "0");
            uciMesh.set("aredn", "multiwan", "wan_enable", wanEnabled ? "1" : "0");
            uciMesh.set("aredn", "multiwan", "wan2_enable", wan2Enabled ? "1" : "0");
            for (let i = 1; i <= 5; i++) {
                const name = `port${i}`;
                uciMesh.set("aredn", "multiwan", `${name}_role`, roles[name]);
                uciMesh.set("aredn", "multiwan", `${name}_dtd`, request.args[`dtd_${name}`] === "on" ? "1" : "0");
            }
            uciMesh.commit("aredn");
            if (action === "apply") {
                uciMesh.set("aredn", "multiwan", "enabled", "1");
                uciMesh.set("aredn", "multiwan", "port_roles_enabled", "1");
                uciMesh.commit("aredn");
                system("/usr/local/bin/wan-port-manager apply >/tmp/wan-port-manager/apply.log 2>&1 &");
                message = "Ethernet roles are being applied. Reconnect and confirm within the rollback window.";
            }
            else message = "Ethernet role choices saved but not applied";
        }
    }
    else if (action === "confirm") {
        const token = request.args.token || "";
        if (!match(token, /^[0-9]+-[0-9]+$/)) error = "No valid rollback token is available";
        else if (system(`/usr/local/bin/wan-port-manager confirm ${token} >/dev/null 2>&1`) === 0) message = "Ethernet role change confirmed";
        else error = "Could not confirm the Ethernet role change";
    }
    else if (action === "restore") {
        uciMesh.set("aredn", "multiwan", "port_roles_enabled", "0");
        uciMesh.commit("aredn");
        system("/usr/local/bin/wan-port-manager restore >/tmp/wan-port-manager/restore.log 2>&1 &");
        message = "AREDN Ethernet defaults are being restored";
    }
    else error = "Invalid Ethernet role action";
}
if (request.env.REQUEST_METHOD === "DELETE") {
    configuration.revertModalChanges();
    print(_R("changes"));
    return;
}

const ports = loadPorts();
const ethPorts = hardware.getEthernetPorts();
const haveXlinks = hardware.supportsFeature("xlink");
const xlinks = loadXlinks();
const defxcost = uciMesh.get("babel", "xlink", "rxcost");
const state = readJson("/tmp/wan-port-manager/state.json");
let gps = "";
const gf = fs.popen("/usr/local/bin/wan-port-manager gps-status 2>/dev/null");
if (gf) { gps = trim(gf.read("all") || ""); gf.close(); }
const roleEnabled = uciMesh.get("aredn", "multiwan", "port_roles_enabled") === "1";
%}
<div class="dialog pollywan-dialog pollywan-ports-page">
    {{_R("dialog-header", "hAP Ports &amp; XLinks")}}
    <div>
        {% if (error) { %}<div class="pw-notice pw-notice-error"><b>{{error}}</b></div>{% } else if (message) { %}<div class="pw-notice pw-notice-ok">{{message}}</div>{% } %}
        <div class="cols"><div><div class="o">Ethernet role state</div><div class="m">{{state && state.message || "No managed Ethernet roles have been applied"}}</div></div><div style="flex:0;text-align:right"><div>{{state && state.applied ? "managed" : "AREDN defaults"}}</div><div class="m">{{state && state.pending_token ? "rollback pending" : "stable"}}</div></div></div>
        <div class="cols"><div><div class="o">WAN 1 ownership</div><div class="m">Shown here because Ethernet role ownership is managed on this page</div></div><div style="flex:0;text-align:right"><div>{{wifiWan.label}}</div><div class="m">{{wifiWan.active ? "Ethernet WAN 1 is unavailable" : "Ethernet WAN 1 may be assigned below"}}</div></div></div>
        <form id="ethernet-role-form">
            <div class="cols"><div><div class="o">Manage Ethernet roles with PollyWAN</div><div class="m">Second explicit opt-in; installation alone never changes a port or radio mode</div></div><div style="flex:0"><input type="checkbox" name="port_roles_enabled" {{roleEnabled ? "checked" : ""}}></div></div>
            <div class="cols"><div><div class="o">Enable local candidates</div><div class="m">WAN 1 is {{wifiWan.active ? wifiWan.label : "Ethernet"}}; WAN 2 is Ethernet; WAN 3 is permanently USB</div></div><div style="flex:0;white-space:nowrap"><label>WAN 1 <input type="checkbox" name="wan_enable" {{uciMesh.get("aredn", "multiwan", "wan_enable") !== "0" ? "checked" : ""}}></label> <label>WAN 2 <input type="checkbox" name="wan2_enable" {{uciMesh.get("aredn", "multiwan", "wan2_enable") === "1" ? "checked" : ""}}></label></div></div>
            <div class="ports pollywan-ports-table-wrap"><div><table><thead><tr><td></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; %}<td class="{{p.active ? "active" : ""}}"><div>{{p.label}}</div><div>{{p.device}}</div></td>{% } %}<td><div>USB</div><div>phone</div></td></tr></thead><tbody>
                <tr><td><div>untagged</div><div>role</div></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; const displayRole = wifiWan.active && p.role === "wan" ? "off" : p.role; %}<td><select name="role_{{p.name}}"><option value="lan" {{displayRole === "lan" ? "selected" : ""}}>LAN</option>{% if (!wifiWan.active) { %}<option value="wan" {{displayRole === "wan" ? "selected" : ""}}>WAN 1</option>{% } %}<option value="wan2" {{displayRole === "wan2" ? "selected" : ""}}>WAN 2</option><option value="off" {{displayRole === "off" ? "selected" : ""}}>Disabled</option></select></td>{% } %}<td><b>WAN 3</b></td></tr>
                <tr><td><div>DtD</div><div>VLAN 2 tagged</div></td>{% for (let i = 0; i < length(ports); i++) { const p = ports[i]; %}<td><input type="checkbox" name="dtd_{{p.name}}" {{p.dtd ? "checked" : ""}}></td>{% } %}<td>&mdash;</td></tr>
            </tbody></table></div></div>
        </form>
        {{_H("This table follows AREDN's advanced Ports design: each physical Ethernet port has one untagged role and may also carry tagged DtD VLAN 2. When an AREDN radio is in WAN client mode, that radio owns logical wan/WAN 1 and the package removes its Ethernet WAN override. WAN 2 remains assignable to Ethernet and WAN 3 remains Android USB tether. Applying writes reversible AREDN include files and starts a timed rollback.")}}
        {% if (haveXlinks) { %}
        <hr>
        <div class="xlinks">
            <div class="cols"><div><div class="o">XLinks</div><div class="m">Normal AREDN XLinks across non-AREDN networks. They are not Internet WAN candidates.</div></div><button class="add" type="button">+</button></div>
            <form id="xlink-form">
                <div id="xlink-list" class="pollywan-xlinks-wrap">
                    <div class="xlink-label adr"><div><div>vlan</div><div>ip a&zwnj;ddress</div><div>cidr</div><div>cost</div><div>port</div><div>note</div></div><div></div></div>
                    {% for (let i = 0; i < length(xlinks); i++) { const x = xlinks[i]; %}
                    <div class="xlink adr" data-name="{{x.name}}"><div>
                        <input name="vlan" type="text" size="5" required pattern="([4-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5])" placeholder="VLan" value="{{x.vlan}}">
                        <input name="ipaddr" type="text" size="25" required pattern="{{constants.patIP}}" placeholder="IP A&zwnj;ddress" value="{{x.ipaddr}}">
                        <select name="cidr">{% for (let cidr = 32; cidr >= 16; cidr--) { %}<option value="{{cidr}}" {{x.cidr === cidr ? "selected" : ""}}>{{cidr === 32 ? "PtP" : "/ " + cidr}}</option>{% } %}</select>
                        <input name="cost" type="text" size="4" pattern="([0-9]|[1-9][0-9]{1,3})" placeholder="{{defxcost}}" value="{{x.cost}}">
                        <select name="port">{% for (let j = 0; j < length(ethPorts); j++) { const p = ethPorts[j]; %}<option value="{{p.k}}" {{x.port === p.k ? "selected" : ""}}>{{p.d}}</option>{% } %}</select>
                        <input name="note" type="text" placeholder="Note" value="{{x.note}}">
                    </div><button type="button">-</button></div>
                    {% } %}
                </div>
            </form>
            <div class="pw-actions"><button type="button" id="save-xlinks">Save XLinks</button></div>
        </div>
        {{_H("This editor intentionally reuses AREDN's xlink UCI layout: xlink interface sections plus bridge VLAN sections in /etc/config.mesh/xlink. Saving Ethernet roles preserves those sections. Saving XLinks does not change PollyWAN WAN-role VLAN assignments.")}}
        {% } %}
        {{_H("GPS safety: WAN 3 only inspects network devices under /sys/class/net. It never opens /dev/ttyACM0 or /dev/ttyUSB0, never edits gpsd, AREDN GPS time/location settings, radio mode, or USB power. Current GPS observation: " + (gps || "not available") + ".")}}
        <div class="pw-actions"><button hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-include="#ethernet-role-form" hx-vals='{"action":"save"}'>Save roles</button><button hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-include="#ethernet-role-form" hx-vals='{"action":"apply"}'>Apply with rollback</button>{% if (state && state.pending_token) { %}<button hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-vals='{"action":"confirm","token":"{{state.pending_token}}"}'>Confirm working</button>{% } %}<div class="pw-spacer"></div><button hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-vals='{"action":"restore"}'>Restore AREDN defaults</button></div>
    </div>
    {{_R("dialog-footer")}}
    <script>(function(){
        {{_R("open")}}
        const patIP = "((25[0-5]|(2[0-4]|1[0-9]|[1-9]|)[0-9])\\.?\\b){4}";
        const xlinks = {{sprintf("%J", xlinks)}};
        function updateXlinkModel(target) {
            const xlink = xlinks.find(x => x.name == target.dataset.name);
            if (!xlink) return;
            xlink.vlan = parseInt(htmx.find(target, "[name=vlan]").value);
            xlink.ipaddr = htmx.find(target, "[name=ipaddr]").value;
            const cost = htmx.find(target, "[name=cost]").value;
            xlink.cost = cost ? parseInt(cost) : null;
            xlink.port = htmx.find(target, "[name=port]").value;
            xlink.cidr = parseInt(htmx.find(target, "[name=cidr]").value);
            xlink.note = htmx.find(target, "[name=note]").value || "";
        }
        htmx.on("#ctrl-modal .dialog #xlink-list", "change", event => {
            if (!htmx.closest(htmx.find("#ctrl-modal .dialog #xlink-list"), "form").checkValidity()) return;
            const target = htmx.closest(event.target, "[data-name]");
            if (target) updateXlinkModel(target);
        });
        htmx.on("#ctrl-modal .dialog #xlink-list", "click", event => {
            if (event.target.nodeName !== "BUTTON") return;
            const target = htmx.closest(event.target, "[data-name]");
            const index = xlinks.findIndex(x => x.name == target.dataset.name);
            if (index >= 0) xlinks.splice(index, 1);
            htmx.remove(target);
        });
        function newXlinkEntry() {
            let name;
            for (let i = 0;; i++) {
                name = `xlink${i}`;
                if (!htmx.find(`#ctrl-modal .dialog #xlink-list .xlink[data-name=${name}]`)) break;
            }
            xlinks.push({ name: name, vlan: "", ipaddr: "", cost: null, port: null, cidr: 32, note: "" });
            const div = document.createElement("div");
            div.innerHTML = `<div class="xlink adr" data-name="${name}"><div>
<input name="vlan" type="text" size="5" required pattern="([4-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5])" placeholder="VLan">
<input name="ipaddr" type="text" size="25" required pattern="${patIP}" placeholder="IP A&zwnj;ddress">
<select name="cidr"><option value="32">PtP</option><option value="31">/ 31</option><option value="30">/ 30</option><option value="29">/ 29</option><option value="28">/ 28</option><option value="27">/ 27</option><option value="26">/ 26</option><option value="25">/ 25</option><option value="24">/ 24</option><option value="23">/ 23</option><option value="22">/ 22</option><option value="21">/ 21</option><option value="20">/ 20</option><option value="19">/ 19</option><option value="18">/ 18</option><option value="17">/ 17</option><option value="16">/ 16</option></select>
<input name="cost" type="text" size="4" pattern="([0-9]|[1-9][0-9]{1,3})" placeholder="{{defxcost}}">
<select name="port">{% for (let j = 0; j < length(ethPorts); j++) { const p = ethPorts[j]; %}<option value="{{p.k}}">{{p.d}}</option>{% } %}</select>
<input name="note" type="text" placeholder="Note"></div><button type="button">-</button></div>`;
            const entry = div.firstChild;
            htmx.find("#ctrl-modal .dialog #xlink-list").appendChild(entry);
            htmx.find(entry, "input").focus();
        }
        htmx.on("#ctrl-modal .dialog .xlinks .add", "click", newXlinkEntry);
        htmx.on("#ctrl-modal .dialog #save-xlinks", "click", _ => {
            const form = htmx.find("#ctrl-modal .dialog #xlink-form");
            if (!form.checkValidity()) { form.reportValidity(); return; }
            for (const entry of htmx.findAll("#ctrl-modal .dialog #xlink-list .xlink")) updateXlinkModel(entry);
            htmx.ajax("PUT", "{{request.env.REQUEST_URI}}", { target: "#ctrl-modal", swap: "innerHTML", values: { action: "save-xlinks", xlinks: JSON.stringify(xlinks) } });
        });
        htmx.on("#dialog-done", "click", _ => htmx.ajax("GET", "/a/u-ethernet-ports", { target: "#ethernet-ports", swap: "outerHTML" }));
    })();</script>
</div>
