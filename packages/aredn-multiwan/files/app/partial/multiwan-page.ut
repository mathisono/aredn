{%
function labelPath(value) { return value === "wan" ? "WAN 1" : value === "wan2" ? "WAN 2" : value === "wan3" ? "Android USB tether" : value === "mesh" ? "Remote Mesh WAN" : "Unknown"; }
function readPolicyStatus() { const v = fs.readfile("/tmp/wan-sla/status.json"); if (!v) return null; try { return json(v); } catch (_) { return null; } }
function runtimeState(enabled, status)
{
    // Deterministic dashboard state map: disabled, scheduler/evaluation, active upstream/export health, route transition, then no eligible fallback.
    if (!enabled) return "Disabled";
    if (!status) return "Idle";
    if (status.health === "checking" || status.probe_reason === "manual_check") return "Checking";
    if (status.health === "switching" || status.health === "failover") return "Failing over";
    if (!status.active) return "No eligible WAN";
    if (status.upstream_reachable && status.mesh_exported) return "Healthy";
    if (status.upstream_reachable && !status.export_eligible) return "Holding";
    if (!status.upstream_reachable && status.selection_healthy) return "Degraded";
    return "No eligible WAN";
}
function runtimeTone(state)
{
    if (state === "Healthy") return "pw-state-ok";
    if (state === "Checking") return "pw-state-info";
    if (state === "Degraded" || state === "Holding" || state === "Failing over") return "pw-state-warn";
    if (state === "No eligible WAN") return "pw-state-bad";
    return "";
}
const enabled = uciMesh.get("aredn", "multiwan", "enabled") === "1";
let mode = uciMesh.get("aredn", "multiwan", "selection_mode") || "manual";
if (mode === "availability" || mode === "adaptive") mode = "automatic";
const active = uciMesh.get("aredn", "multiwan", "active") || "wan";
const release = "r30";
const status = readPolicyStatus();
const currentRuntime = runtimeState(enabled, status);
const runtimeStates = [ "Disabled", "Idle", "Checking", "Healthy", "Degraded", "Holding", "Failing over", "No eligible WAN" ];
%}
<div id="multiwan-page" class="pw-page" hx-get="u-multiwan" hx-trigger="every 10s [document.visibilityState === 'visible']" hx-swap="outerHTML">
    <header class="pw-hero">
        <div class="pw-title-row">
            <div>
                <h1>PollyWAN</h1>
                <p class="pw-subtitle">Adaptive multi-WAN routing for AREDN</p>
            </div>
            <div class="pw-muted">Refreshes every 10 seconds</div>
        </div>
        <div class="pw-badges" aria-label="PollyWAN summary">
            <span class="pw-badge {{enabled ? "pw-status-ok" : "pw-status-off"}}"><span class="pw-status-dot"></span>Controller {{enabled ? "Enabled" : "Disabled"}}</span>
            <span class="pw-badge pw-status-active"><span class="pw-status-dot"></span>Active: {{labelPath(active)}}</span>
            <span class="pw-badge">{{mode}}</span>
            <span class="pw-badge">{{release}}</span>
        </div>
        <div class="pw-state-strip" aria-label="Runtime state">
            {% for (let i = 0; i < length(runtimeStates); i++) { const item = runtimeStates[i]; %}
            <span class="pw-state-item {{item === currentRuntime ? "pw-state-current " + runtimeTone(item) : "pw-state-inactive"}}"><span class="pw-status-dot"></span>{{item}}</span>
            {% } %}
        </div>
    </header>
    <div class="pw-grid">
    {{_R("wan-policy")}}
    {{_R("ethernet-ports")}}
    {{_R("link-calibration")}}
        <section class="pw-card pw-card-full" aria-labelledby="pw-doc-title">
            <div class="pw-card-head">
                <div>
                    <h2 id="pw-doc-title">Documentation</h2>
                    <div class="pw-muted">Port roles, USB tethering, route policy, GPS safety, verification, and recovery.</div>
                </div>
                <a class="pw-doc-link" target="_blank" href="/apps/aredn-multiwan/help.html">Open setup and recovery guide</a>
            </div>
        </section>
    </div>
</div>
