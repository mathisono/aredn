#!/bin/sh
# PollyWAN ordered route selector. Reachability is a hard gate. Optional speed
# measurements can enforce a minimum data rate for local routes, but never
# reorder the administrator's explicit route priority.

set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C

STATE_DIR=/tmp/wan-sla
STATUS_FILE="$STATE_DIR/status.json"
TELEMETRY_FILE="$STATE_DIR/telemetry.json"
CANDIDATE_FILE="$STATE_DIR/candidates.tsv"
LOCK_DIR="$STATE_DIR/.lock"
PROMOTE_FILE="$STATE_DIR/promote-candidate"
STREAK_FILE="$STATE_DIR/promote-streak"
SWITCH_FILE="$STATE_DIR/last-switch"
INHIBIT_FILE="$STATE_DIR/inhibit"
EXPORT_CANDIDATE_FILE="$STATE_DIR/export-recover-candidate"
EXPORT_STREAK_FILE="$STATE_DIR/export-recover-streak"
EXPORT_CHANGE_FILE="$STATE_DIR/last-export-change"
CONFIG_PACKAGE=aredn
CONFIG_SECTION=multiwan
REMOTE_MESH_TABLE=22
WAN1_TRANSPORT=unknown
PACKAGE_VERSION=0.1.0-r29.5
MANUAL_CHECK=0

mkdir -p "$STATE_DIR" || exit 1

uci_get()
{
    uci -c /etc/config.mesh -q get "$CONFIG_PACKAGE.$CONFIG_SECTION.$1" 2>/dev/null || true
}

aredn_wan_get()
{
    uci -c /etc/config.mesh -q get "aredn.@wan[0].$1" 2>/dev/null || true
}

json_escape()
{
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r/\\r/g; s/\n/\\n/g'
}

json_number_or_null()
{
    case "${1:-}" in
        ''|*[!0-9.]*|.*|*.*.*) printf null ;;
        *) printf '%s' "$1" ;;
    esac
}

package_has_effects()
{
    [ -e /etc/aredn_include/.aredn-multiwan-ports ] && return 0
    ip -4 route show table 26 default 2>/dev/null | grep -q '^default' && return 0
    ubus call network.interface.wan3 status >/dev/null 2>&1 && return 0
    return 1
}

valid_uint()
{
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

number_setting()
{
    name="$1"; default="$2"; minimum="$3"; maximum="$4"
    value="$(uci_get "$name")"
    valid_uint "$value" || value="$default"
    [ "$value" -ge "$minimum" ] || value="$minimum"
    [ "$value" -le "$maximum" ] || value="$maximum"
    printf '%s\n' "$value"
}

class_score()
{
    case "$1" in low) echo 2 ;; medium) echo 3 ;; fast) echo 4 ;; *) echo 1 ;; esac
}

candidate_enabled()
{
    case "$1" in
        wan) [ "$(uci_get wan_enable)" != 0 ] ;;
        wan2) [ "$(uci_get wan2_enable)" != 0 ] ;;
        wan3) [ "$(uci_get wan3_enable)" = 1 ] ;;
        mesh) [ "$(uci_get mesh_enable)" = 1 ] ;;
        *) return 1 ;;
    esac
}

valid_ipv4()
{
    printf '%s\n' "$1" | awk -F. '
        NF != 4 { bad = 1 }
        { for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) bad = 1 }
        END { exit bad }
    '
}

inspect_candidate()
{
    /usr/local/bin/wan3-manager inspect "$1" 2>/dev/null
}

calibration_configured()
{
    host="$(uci_get calibration_host)"
    url="$(uci_get calibration_url)"
    case "$host" in ''|*[!A-Za-z0-9.-]*) return 1 ;; esac
    case "$url" in "https://$host/"?*) return 0 ;; *) return 1 ;; esac
}

health_url()
{
    option="${1:-health_url}"
    url="$(uci_get "$option")"
    if [ "$option" != health_url ] && [ -z "$url" ]; then return 1; fi
    case "$url" in
        https://*/*) ;;
        *) [ "$option" = health_url ] && printf '%s\n' 'https://connectivitycheck.gstatic.com/generate_204' || return 1; return ;;
    esac
    host="${url#https://}"; host="${host%%/*}"
    case "$host" in
        ''|*:*|*[^A-Za-z0-9.-]*|.*|*..*|*.) [ "$option" = health_url ] && printf '%s\n' 'https://connectivitycheck.gstatic.com/generate_204' || return 1 ;;
        *) printf '%s\n' "$url" ;;
    esac
}

health_code_allowed()
{
    code="$1"; option="${2:-health_expected_codes}"
    codes="$(uci_get "$option")"
    [ -n "$codes" ] || codes=204
    old_ifs="$IFS"; IFS=', '; set -- $codes; IFS="$old_ifs"
    for allowed in "$@"; do
        case "$allowed" in
            *[!0-9]*|'') continue ;;
            *) [ "$code" = "$allowed" ] && return 0 ;;
        esac
    done
    return 1
}

probe_interval_for()
{
    name="$1"; active="$2"; upstream="$3"
    if [ "$name" = "$active" ]; then
        number_setting health_interval 30 10 3600
    elif [ "$upstream" = 1 ]; then
        number_setting standby_health_interval 90 10 3600
    else
        base="$(number_setting failed_probe_interval 120 10 3600)"
        max="$(number_setting failed_probe_interval_max 300 10 3600)"
        [ "$base" -le "$max" ] || base="$max"
        printf '%s\n' "$base"
    fi
}

mark_next_probe()
{
    name="$1"; active="$2"; upstream="$3"
    now="$(date +%s)"
    interval="$(probe_interval_for "$name" "$active" "$upstream")"
    printf '%s\n' $((now + interval)) > "$STATE_DIR/next-probe.$name"
}

probe_due()
{
    [ "$MANUAL_CHECK" = 1 ] && return 0
    name="$1"; values="$2"
    old_ifs="$IFS"; IFS='|'; set -- $values; IFS="$old_ifs"
    device="$1"
    state="$STATE_DIR/interface.$name"
    previous="$(cat "$state" 2>/dev/null || true)"
    printf '%s\n' "$device" > "$state"
    [ "$previous" != "$device" ] && return 0
    next="$(cat "$STATE_DIR/next-probe.$name" 2>/dev/null || true)"
    valid_uint "$next" || return 0
    now="$(date +%s)"
    [ "$now" -ge "$next" ]
}

route_valid()
{
    device="$1"; source="$2"; gateway="$3"
    valid_ipv4 "$source" || return 1
    valid_ipv4 "$gateway" || return 0
    route="$(ip -4 route get "$gateway" from "$source" oif "$device" 2>/dev/null)" || return 1
    printf '%s\n' "$route" | grep -q "dev $device" || return 1
    printf '%s\n' "$route" | grep -Eq '(^| )(unreachable|prohibit|blackhole|throw)( |$)' && return 1
    # OpenWrt/iproute may echo a source-constrained lookup as either
    # "src SOURCE" or "from SOURCE"; both prove the candidate source was used.
    printf '%s\n' "$route" | grep -Eq "(src|from) $source( |$)" || return 1
}

gateway_icmp_probe()
{
    device="$1"; source="$2"; gateway="$3"
    valid_ipv4 "$gateway" || return 1
    ping -c 1 -W 2 -I "$source" "$gateway" >/dev/null 2>&1 && return 0
    ping -c 1 -W 2 -I "$device" "$gateway" >/dev/null 2>&1
}

https_probe()
{
    name="$1"; source="$2"; url_option="${3:-health_url}"; codes_option="${4:-health_expected_codes}"
    valid_ipv4 "$source" || return 1
    url="$(health_url "$url_option")" || return 1
    set -- --silent --show-error --fail --proto '=https' --proto-redir '=https' --max-redirs 0 \
        --connect-timeout 5 --max-time 12 --interface "$source" --output /dev/null --write-out '%{http_code}'
    set -- "$@" --proxy ''
    code="$(curl "$@" "$url" 2>/dev/null || true)"
    health_code_allowed "$code" "$codes_option" || return 1
    PROBE_ENDPOINT="$url"
    return 0
}

availability_probe()
{
    name="$1"; device="$2"; source="$3"; gateway="$4"
    GATEWAY_REACHABLE=0
    UPSTREAM_REACHABLE=0
    PROBE_ENDPOINT=
    if ! route_valid "$device" "$source" "$gateway"; then
        PROBE_REASON=route_invalid
        return 1
    fi
    if gateway_icmp_probe "$device" "$source" "$gateway"; then
        GATEWAY_REACHABLE=1
    fi
    if https_probe "$name" "$source"; then
        UPSTREAM_REACHABLE=1
        PROBE_REASON=https_reachable
        return 0
    fi
    if https_probe "$name" "$source" health_url_secondary health_secondary_expected_codes; then
        UPSTREAM_REACHABLE=1
        PROBE_REASON=https_secondary_reachable
        return 0
    fi
    if [ "$GATEWAY_REACHABLE" = 1 ]; then
        PROBE_REASON=upstream_unreachable
    else
        PROBE_REASON=gateway_and_upstream_unreachable
    fi
    return 1
}

probe_path()
{
    name="$1"; values="$2"
    old_ifs="$IFS"; IFS='|'; set -- $values; IFS="$old_ifs"
    device="$1"; source="$2"; gateway="${3:-}"

    # Calibration measures performance; it is not the Internet reachability
    # gate. Availability always validates route and source-bound reachability.
    # Adaptive mode still will not select a path until a fresh speed class exists.
    if probe_due "$name" "$values"; then
        availability_probe "$name" "$device" "$source" "$gateway"
        rc=$?
        mark_next_probe "$name" "$(uci_get active)" "$UPSTREAM_REACHABLE"
        return "$rc"
    fi

    cached="$(awk -F'|' -v name="$name" '$1 == name { print; exit }' "$CANDIDATE_FILE.last" 2>/dev/null || true)"
    if [ -n "$cached" ]; then
        old_ifs="$IFS"; IFS='|'; set -- $cached; IFS="$old_ifs"
        GATEWAY_REACHABLE="${4:-0}"
        UPSTREAM_REACHABLE="${5:-0}"
        PROBE_REASON="${15:-scheduled_wait}"
        PROBE_ENDPOINT="${20:-}"
        [ "$UPSTREAM_REACHABLE" = 1 ] && return 0
    fi
    availability_probe "$name" "$device" "$source" "$gateway"
    rc=$?
    mark_next_probe "$name" "$(uci_get active)" "$UPSTREAM_REACHABLE"
    return "$rc"
}

failure_count()
{
    name="$1"; action="$2"; file="$STATE_DIR/failures.$name"
    count="$(cat "$file" 2>/dev/null || true)"
    valid_uint "$count" || count=0
    if [ "$action" = reset ]; then count=0; else count=$((count + 1)); fi
    printf '%s\n' "$count" > "$file"
    printf '%s\n' "$count"
}

private_table()
{
    case "$1" in wan) echo 101 ;; wan2) echo 102 ;; wan3) echo 103 ;; *) echo null ;; esac
}

last_epoch_or_null()
{
    value="$(cat "$1" 2>/dev/null || true)"
    valid_uint "$value" && printf '%s\n' "$value" || printf 'null\n'
}

set_export_change_now()
{
    date +%s > "$EXPORT_CHANGE_FILE"
}

reset_export_recovery()
{
    : > "$EXPORT_CANDIDATE_FILE"
    printf '0\n' > "$EXPORT_STREAK_FILE"
}

export_recovery_ready()
{
    candidate="$1"; required="$2"; hold_down="$3"
    now="$(date +%s)"
    last="$(cat "$EXPORT_CHANGE_FILE" 2>/dev/null || true)"
    valid_uint "$last" || last=0
    [ $((now - last)) -ge "$hold_down" ] || return 1
    current="$(cat "$EXPORT_CANDIDATE_FILE" 2>/dev/null || true)"
    streak="$(cat "$EXPORT_STREAK_FILE" 2>/dev/null || true)"
    valid_uint "$streak" || streak=0
    if [ "$current" = "$candidate" ]; then streak=$((streak + 1)); else current="$candidate"; streak=1; fi
    printf '%s\n' "$current" > "$EXPORT_CANDIDATE_FILE"
    printf '%s\n' "$streak" > "$EXPORT_STREAK_FILE"
    [ "$streak" -ge "$required" ]
}

result_values()
{
    name="$1"; values="$2"; ttl="$3"
    result="/tmp/wan-speed/$name.json"
    [ -r "$result" ] || return 1
    old_ifs="$IFS"; IFS='|'; set -- $values; IFS="$old_ifs"
    source="$2"; gateway="${3:-}"

    timestamp="$(jsonfilter -i "$result" -e '@.timestamp' 2>/dev/null || true)"
    result_source="$(jsonfilter -i "$result" -e '@.source' 2>/dev/null || true)"
    result_gateway="$(jsonfilter -i "$result" -e '@.gateway' 2>/dev/null || true)"
    valid="$(jsonfilter -i "$result" -e '@.valid' 2>/dev/null || true)"
    bin="$(jsonfilter -i "$result" -e '@.class' 2>/dev/null || true)"
    mbps="$(jsonfilter -i "$result" -e '@.mbps' 2>/dev/null || true)"
    valid_uint "$timestamp" || return 1
    case "$valid" in true|1) ;; *) return 1 ;; esac
    case "$bin" in low|medium|fast) ;; *) return 1 ;; esac
    [ "$result_source" = "$source" ] || return 1
    if [ "$result_gateway" != '-' ] && [ -n "$gateway" ] && [ "$result_gateway" != "$gateway" ]; then return 1; fi
    now="$(date +%s)"; age=$((now - timestamp))
    [ "$age" -ge 0 ] || return 1
    [ "$age" -le "$ttl" ] || return 1
    printf '%s|%s|%s|%s\n' "$bin" "$mbps" "$timestamp" "$age"
}

maybe_calibrate()
{
    name="$1"; interval="$2"
    [ "$(uci_get speed_test_auto)" = 1 ] || return 0
    [ -e /tmp/wan-speed/.lock ] && return 0
    [ -e /tmp/wan-port-manager/pending-token ] && return 0
    result="/tmp/wan-speed/$name.json"
    timestamp="$(jsonfilter -i "$result" -e '@.timestamp' 2>/dev/null || true)"
    valid_uint "$timestamp" || timestamp=0
    now="$(date +%s)"; age=$((now - timestamp))
    [ "$age" -ge "$interval" ] || return 0
    /usr/local/bin/wan-speed-test test "$name" cloudflare "$(uci_get speed_test_payload)" >/dev/null 2>&1 || true
}

evaluate_candidate()
{
    name="$1"; mode="$2"; min_score="$3"; result_ttl="$4"; calibration_interval="$5"; failure_limit="$6"

    if ! candidate_enabled "$name"; then
        printf '%s|0|0|0|0|0|0|0|unknown|0|0|disabled|disabled|0|disabled|standby|%s:0| | | |%s|0\n' "$name" "$(uci_get active)" "$(private_table "$name")"
        return
    fi
    values="$(inspect_candidate "$name" 2>/dev/null || true)"
    if [ -z "$values" ]; then
        failure_count "$name" fail >/dev/null
        role=standby; [ "$name" = "$(uci_get active)" ] && role=active
        printf '%s|1|0|0|0|0|0|0|down|0|0| |interface_down|0|interface_down|%s|%s:0| | | |%s|0\n' "$name" "$role" "$(uci_get active)" "$(private_table "$name")"
        return
    fi
    old_ifs="$IFS"; IFS='|'; set -- $values; IFS="$old_ifs"
    device="$1"; source="$2"; gateway="${3:-}"

    current_active="$(uci_get active)"
    selection_role=
    probe_ok=0
    PROBE_REASON=probe_failed
    GATEWAY_REACHABLE=0
    UPSTREAM_REACHABLE=0
    PROBE_ENDPOINT=
    if probe_path "$name" "$values"; then
        probe_ok=1
        failures="$(failure_count "$name" reset)"
        healthy=1; reason="$PROBE_REASON"
    else
        failures="$(failure_count "$name" fail)"
        if [ "$failures" -ge "$failure_limit" ]; then
            healthy=0; reason="$PROBE_REASON"
        elif [ "$name" = "$current_active" ]; then
            # A selected path receives the configured failure hysteresis. A
            # currently failing standby is never eligible for promotion.
            healthy=1; reason=probe_retry
        else
            healthy=0; reason="$PROBE_REASON"; selection_role=standby
        fi
    fi

    if [ "$probe_ok" = 1 ] && [ "$mode" = ordered ]; then maybe_calibrate "$name" "$calibration_interval"; fi

    result="$(result_values "$name" "$values" "$result_ttl" 2>/dev/null || true)"
    if [ -n "$result" ]; then
        old_ifs="$IFS"; IFS='|'; set -- $result; IFS="$old_ifs"
        bin="$1"; mbps="$2"; age="$4"; raw_score="$(class_score "$bin")"
        printf '%s\n' "$mbps" | awk 'BEGIN { ok = 0 } /^[0-9]+([.][0-9]+)?$/ { ok = 1 } END { exit !ok }' || mbps=0
    else
        bin=unknown; mbps=0; age=0; raw_score=1
    fi

    score=0
    if [ "$healthy" = 1 ]; then
        # The default "Any" floor permits a healthy route without a current
        # speed test. Higher floors require a fresh measured class.
        if [ "$mode" = ordered ] && { { [ "$min_score" -le 2 ] && [ "$raw_score" -eq 1 ]; } || [ "$raw_score" -ge "$min_score" ]; }; then
            score="$raw_score"
        fi
    fi
    persisted_active="$(uci_get active)"
    route_active=0
    ip -4 route show table 26 default 2>/dev/null | grep -q '^default' && route_active=1
    [ -n "${selection_role:-}" ] || { [ "$name" = "$persisted_active" ] && selection_role=active || selection_role=standby; }
    route_ok=1
    [ "$PROBE_REASON" = route_invalid ] && route_ok=0
    printf '%s|1|1|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s:%s|%s|%s|%s|%s|%s\n' \
        "$name" "$route_ok" "$GATEWAY_REACHABLE" "$UPSTREAM_REACHABLE" "$healthy" "$UPSTREAM_REACHABLE" \
        "$bin" "$score" "$mbps" "$device" "$reason" "$age" "$reason" "$selection_role" \
        "$persisted_active" "$route_active" "$source" "$gateway" "$PROBE_ENDPOINT" "$(private_table "$name")" "$failures"
}

evaluate_mesh_candidate()
{
    active="$(uci_get active)"
    role=standby; [ "$active" = mesh ] && role=active
    if ! candidate_enabled mesh; then
        printf 'mesh|0|0|0|0|0|0|0|unknown|0|0| |disabled|0|disabled|%s|%s:0| | | |22|0\n' "$role" "$active"
    elif ip -4 route show table "$REMOTE_MESH_TABLE" default 2>/dev/null | grep -q '^default'; then
        # AREDN/Babel owns and qualifies the remote default. PollyWAN does not
        # re-export it or pretend it has a locally measurable data rate.
        printf 'mesh|1|1|1|1|1|1|0|unknown|1|0| |remote_mesh_default|0|remote_mesh_default|%s|%s:0| | | |22|0\n' "$role" "$active"
    else
        printf 'mesh|1|0|0|0|0|0|0|unknown|0|0| |remote_mesh_unavailable|0|remote_mesh_unavailable|%s|%s:0| | | |22|0\n' "$role" "$active"
    fi
}

read_active_line()
{
    active="$1"
    awk -F'|' -v active="$active" '$1 == active { print; exit }' "$CANDIDATE_FILE"
}

choose_candidate()
{
    for slot in 1 2 3 4; do
        name="$(uci_get "priority_$slot")"
        case "$name" in wan|wan2|wan3|mesh) ;; *) continue ;; esac
        line="$(awk -F'|' -v name="$name" '$1 == name { print; exit }' "$CANDIDATE_FILE")"
        [ -n "$line" ] || continue
        configured="$(printf '%s' "$line" | awk -F'|' '{print $2}')"
        healthy="$(printf '%s' "$line" | awk -F'|' '{print $7}')"
        score="$(printf '%s' "$line" | awk -F'|' '{print $10}')"
        [ "$configured" = 1 ] && [ "$healthy" = 1 ] && [ "$score" -gt 0 ] || continue
        printf '%s|%s\n' "$name" "$score"
        return
    done
    printf '|0\n'
}

candidate_rank()
{
    target="$1"
    for slot in 1 2 3 4; do
        [ "$(uci_get "priority_$slot")" = "$target" ] && { printf '%s\n' "$slot"; return; }
    done
    printf '99\n'
}

reset_promotion()
{
    : > "$PROMOTE_FILE"
    printf '0\n' > "$STREAK_FILE"
}

promotion_ready()
{
    candidate="$1"; required="$2"
    current="$(cat "$PROMOTE_FILE" 2>/dev/null || true)"
    streak="$(cat "$STREAK_FILE" 2>/dev/null || true)"
    valid_uint "$streak" || streak=0
    if [ "$current" = "$candidate" ]; then streak=$((streak + 1)); else current="$candidate"; streak=1; fi
    printf '%s\n' "$current" > "$PROMOTE_FILE"
    printf '%s\n' "$streak" > "$STREAK_FILE"
    [ "$streak" -ge "$required" ]
}

switch_to()
{
    name="$1"
    if [ "$name" = mesh ]; then
        /usr/local/bin/wan3-manager withdraw 'Ordered policy selected Remote Mesh WAN' 1 || return 1
        date +%s > "$SWITCH_FILE"
        reset_export_recovery
        reset_promotion
        return 0
    fi
    line="$(read_active_line "$name")"
    [ -n "$line" ] || return 1
    old_ifs="$IFS"; IFS='|'; set -- $line; IFS="$old_ifs"
    bin="${9:-unknown}"
    export_eligible="${8:-0}"
    /usr/local/bin/wan3-manager select "$name" 1 "$bin" "$export_eligible" || return 1
    date +%s > "$SWITCH_FILE"
    reset_export_recovery
    reset_promotion
}

write_status()
{
    mode="$1"; active="$2"; selected_bin="$3"; message="$4"
    table22=0; table28=0
    ip -4 route show table "$REMOTE_MESH_TABLE" default | grep -q '^default' && table22=1
    ip -4 route show table 28 default | grep -q '^default' && table28=1
    mesh_exit_info="$(/usr/local/bin/wan-mesh-exit 2>/dev/null || printf '0|||||\n')"
    old_ifs="$IFS"; IFS='|'; set -- $mesh_exit_info; IFS="$old_ifs"
    mesh_exit_available="${1:-0}"
    mesh_exit_node="${2:-}"
    mesh_exit_ip="${3:-}"
    mesh_exit_next_hop="${4:-}"
    mesh_exit_interface="${5:-}"
    mesh_exit_metric="${6:-}"
    if [ "$mesh_exit_available" != 1 ] || [ "$mesh_exit_node" = Unknown ]; then mesh_exit_node=; fi
    mesh_to_wan="$(aredn_wan_get mesh_to_local_wan)"; [ "$mesh_to_wan" = 1 ] || mesh_to_wan=0
    lan_to_mesh="$(aredn_wan_get lan_to_remote_wan)"; [ "$lan_to_mesh" = 1 ] || lan_to_mesh=0
    generated="$(date +%s)"

    active_health=unknown
    active_upstream=false
    active_gateway=false
    active_device=
    active_source=
    active_gateway_value=
    active_private_table=null
    active_probe_endpoint=
    active_probe_reason=none
    active_line="$(read_active_line "$active")"
    if [ -n "$active_line" ]; then
        old_ifs="$IFS"; IFS='|'; set -- $active_line; IFS="$old_ifs"
        [ "${7:-0}" = 1 ] && active_health=healthy || active_health=unhealthy
        [ "${6:-0}" = 1 ] && active_upstream=true || active_upstream=false
        [ "${5:-0}" = 1 ] && active_gateway=true || active_gateway=false
        active_device="${12:-}"
        active_source="${18:-}"
        active_gateway_value="${19:-}"
        active_probe_endpoint="${20:-}"
        active_private_table="${21:-null}"
        active_probe_reason="${15:-none}"
    fi
    selected_default=null
    selected_route_table=null
    if [ "$active" = mesh ] && ip -4 route show table "$REMOTE_MESH_TABLE" default 2>/dev/null | grep -q '^default'; then
        selected_default='"0.0.0.0/0"'
        selected_route_table="$REMOTE_MESH_TABLE"
    elif ip -4 route show table 26 default 2>/dev/null | grep -q '^default'; then
        selected_default='"0.0.0.0/0"'
        selected_route_table=26
    fi

    tmp="$STATUS_FILE.tmp.$$"
    {
        printf '{"schema_version":2,"package_version":"%s","enabled":%s,"mode":"%s","active":"%s","active_health":"%s","active_upstream_reachable":%s,"active_gateway_reachable":%s,"active_device":%s,"active_source":%s,"active_gateway":%s,"active_private_table":%s,"selected_route_table":%s,"selected_default":%s,"mesh_exported":%s,"mesh_export_table":28,"last_switch_epoch":%s,"last_export_change_epoch":%s,"generated_at_epoch":%s,"probe_endpoint":%s,"probe_reason":"%s","selected_bin":"%s","wan1_transport":"%s","message":"%s","table28_published":%s,"remote_mesh_default":%s,"remote_mesh_exit_node":%s,"remote_mesh_exit_ip":%s,"remote_mesh_next_hop":%s,"remote_mesh_interface":%s,"remote_mesh_metric":%s,"mesh_to_wan":%s,"lan_to_mesh_wan":%s,"tunnel_guard":true,"time":"%s","candidates":[' \
            "$PACKAGE_VERSION" "$([ "$(uci_get enabled)" = 1 ] && echo true || echo false)" \
            "$(json_escape "$mode")" "$(json_escape "$active")" "$(json_escape "$active_health")" "$active_upstream" "$active_gateway" \
            "$([ -n "$active_device" ] && printf '"%s"' "$(json_escape "$active_device")" || printf null)" \
            "$([ -n "$active_source" ] && [ "$active_source" != ' ' ] && printf '"%s"' "$(json_escape "$active_source")" || printf null)" \
            "$([ -n "$active_gateway_value" ] && [ "$active_gateway_value" != ' ' ] && printf '"%s"' "$(json_escape "$active_gateway_value")" || printf null)" \
            "$active_private_table" "$selected_route_table" "$selected_default" "$([ "$table28" = 1 ] && echo true || echo false)" \
            "$(last_epoch_or_null "$SWITCH_FILE")" "$(last_epoch_or_null "$EXPORT_CHANGE_FILE")" "$generated" \
            "$([ -n "$active_probe_endpoint" ] && [ "$active_probe_endpoint" != ' ' ] && printf '"%s"' "$(json_escape "$active_probe_endpoint")" || printf null)" "$(json_escape "$active_probe_reason")" \
            "$(json_escape "$selected_bin")" "$(json_escape "$WAN1_TRANSPORT")" "$(json_escape "$message")" \
            "$table28" "$table22" \
            "$([ -n "$mesh_exit_node" ] && printf '"%s"' "$(json_escape "$mesh_exit_node")" || printf null)" \
            "$([ -n "$mesh_exit_ip" ] && printf '"%s"' "$(json_escape "$mesh_exit_ip")" || printf null)" \
            "$([ -n "$mesh_exit_next_hop" ] && printf '"%s"' "$(json_escape "$mesh_exit_next_hop")" || printf null)" \
            "$([ -n "$mesh_exit_interface" ] && printf '"%s"' "$(json_escape "$mesh_exit_interface")" || printf null)" \
            "$(json_number_or_null "$mesh_exit_metric")" "$mesh_to_wan" "$lan_to_mesh" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        first=1
        while IFS='|' read -r name configured interface_up route_valid gateway_reachable upstream_reachable healthy export_eligible bin score mbps device reason age probe_reason selection_role active_route source gateway endpoint private_table failures; do
            [ "$first" = 1 ] || printf ','
            first=0
            persisted_active="${active_route%:*}"; route_active="${active_route##*:}"
            [ "$route_active" = 1 ] || route_active=0
            next="$(cat "$STATE_DIR/next-probe.$name" 2>/dev/null || true)"; valid_uint "$next" || next=0
            printf '{"name":"%s","configured":%s,"interface_up":%s,"route_valid":%s,"gateway_reachable":%s,"upstream_reachable":%s,"selection_healthy":%s,"export_eligible":%s,"healthy":%s,"bin":"%s","speed_class":"%s","score":%s,"mbps":%s,"device":%s,"source":%s,"gateway":%s,"private_table":%s,"reason":"%s","probe_reason":"%s","selection_role":"%s","persisted_active":"%s","route_active":%s,"result_age":%s,"failure_count":%s,"next_probe_epoch":%s}' \
                "$(json_escape "$name")" "$configured" \
                "$([ "$interface_up" = 1 ] && echo true || echo false)" "$([ "$route_valid" = 1 ] && echo true || echo false)" \
                "$([ "$gateway_reachable" = 1 ] && echo true || echo false)" "$([ "$upstream_reachable" = 1 ] && echo true || echo false)" \
                "$([ "$healthy" = 1 ] && echo true || echo false)" "$([ "$export_eligible" = 1 ] && echo true || echo false)" "$healthy" \
                "$(json_escape "$bin")" "$(json_escape "$bin")" "$(json_number_or_null "$score")" "$(json_number_or_null "$mbps")" \
                "$([ -n "$device" ] && printf '"%s"' "$(json_escape "$device")" || printf null)" \
                "$([ -n "$source" ] && [ "$source" != ' ' ] && printf '"%s"' "$(json_escape "$source")" || printf null)" \
                "$([ -n "$gateway" ] && [ "$gateway" != ' ' ] && printf '"%s"' "$(json_escape "$gateway")" || printf null)" \
                "${private_table:-null}" "$(json_escape "$reason")" "$(json_escape "${probe_reason:-$reason}")" \
                "$(json_escape "${selection_role:-standby}")" "$(json_escape "$persisted_active")" "$route_active" "$age" "${failures:-0}" "$next"
        done < "$CANDIDATE_FILE"
        printf ']}\n'
    } > "$tmp" && mv "$tmp" "$STATUS_FILE"

    health="$active_health"
    [ "$(uci_get enabled)" = 1 ] || health=disabled
    active_selection_healthy=false
    [ "$active_health" = healthy ] && active_selection_healthy=true
    active_export_eligible=false
    [ -n "$active_line" ] && [ "${8:-0}" = 1 ] && active_export_eligible=true
    active_next="$(cat "$STATE_DIR/next-probe.$active" 2>/dev/null || true)"; valid_uint "$active_next" || active_next=null
    ttmp="$TELEMETRY_FILE.tmp.$$"
    {
        printf '{"schema_version":1,"package_version":"%s","enabled":%s,"mode":"%s","active":%s,"health":"%s","gateway_reachable":%s,"upstream_reachable":%s,"selection_healthy":%s,"export_eligible":%s,"device":%s,"source":%s,"gateway":%s,"private_table":%s,"selected_table":%s,"mesh_exported":%s,"export_table":28,"probe_endpoint":%s,"probe_reason":"%s","next_probe_epoch":%s,"last_switch_epoch":%s,"last_export_change_epoch":%s,"generated_at_epoch":%s,"remote_mesh_exit_node":%s,"remote_mesh_exit_ip":%s,"remote_mesh_next_hop":%s,"remote_mesh_interface":%s,"remote_mesh_metric":%s,"candidates":[' \
            "$PACKAGE_VERSION" "$([ "$(uci_get enabled)" = 1 ] && echo true || echo false)" "$(json_escape "$mode")" \
            "$(case "$active" in wan|wan2|wan3|mesh) printf '"%s"' "$active" ;; *) printf null ;; esac)" \
            "$(json_escape "$health")" "$active_gateway" "$active_upstream" "$active_selection_healthy" "$active_export_eligible" \
            "$([ -n "$active_device" ] && printf '"%s"' "$(json_escape "$active_device")" || printf null)" \
            "$([ -n "$active_source" ] && [ "$active_source" != ' ' ] && printf '"%s"' "$(json_escape "$active_source")" || printf null)" \
            "$([ -n "$active_gateway_value" ] && [ "$active_gateway_value" != ' ' ] && printf '"%s"' "$(json_escape "$active_gateway_value")" || printf null)" \
            "$active_private_table" "$selected_route_table" \
            "$([ "$table28" = 1 ] && echo true || echo false)" \
            "$([ -n "$active_probe_endpoint" ] && [ "$active_probe_endpoint" != ' ' ] && printf '"%s"' "$(json_escape "$active_probe_endpoint")" || printf null)" "$(json_escape "$active_probe_reason")" "$active_next" \
            "$(last_epoch_or_null "$SWITCH_FILE")" "$(last_epoch_or_null "$EXPORT_CHANGE_FILE")" "$generated" \
            "$([ -n "$mesh_exit_node" ] && printf '"%s"' "$(json_escape "$mesh_exit_node")" || printf null)" \
            "$([ -n "$mesh_exit_ip" ] && printf '"%s"' "$(json_escape "$mesh_exit_ip")" || printf null)" \
            "$([ -n "$mesh_exit_next_hop" ] && printf '"%s"' "$(json_escape "$mesh_exit_next_hop")" || printf null)" \
            "$([ -n "$mesh_exit_interface" ] && printf '"%s"' "$(json_escape "$mesh_exit_interface")" || printf null)" \
            "$(json_number_or_null "$mesh_exit_metric")"
        first=1
        while IFS='|' read -r name configured interface_up route_valid gateway_reachable upstream_reachable healthy export_eligible bin score mbps device reason age probe_reason selection_role active_route source gateway endpoint private_table failures; do
            [ "$first" = 1 ] || printf ','
            first=0
            next="$(cat "$STATE_DIR/next-probe.$name" 2>/dev/null || true)"; valid_uint "$next" || next=null
            printf '{"name":"%s","configured":%s,"interface_up":%s,"route_valid":%s,"gateway_reachable":%s,"upstream_reachable":%s,"selection_healthy":%s,"export_eligible":%s,"speed_class":"%s","mbps":%s,"device":%s,"source":%s,"gateway":%s,"private_table":%s,"probe_endpoint":%s,"probe_reason":"%s","failure_count":%s,"next_probe_epoch":%s}' \
                "$(json_escape "$name")" "$([ "$configured" = 1 ] && echo true || echo false)" \
                "$([ "$interface_up" = 1 ] && echo true || echo false)" "$([ "$route_valid" = 1 ] && echo true || echo false)" \
                "$([ "$gateway_reachable" = 1 ] && echo true || echo false)" "$([ "$upstream_reachable" = 1 ] && echo true || echo false)" \
                "$([ "$healthy" = 1 ] && echo true || echo false)" "$([ "$export_eligible" = 1 ] && echo true || echo false)" \
                "$(json_escape "$bin")" "$(json_number_or_null "$mbps")" \
                "$([ -n "$device" ] && printf '"%s"' "$(json_escape "$device")" || printf null)" \
                "$([ -n "$source" ] && [ "$source" != ' ' ] && printf '"%s"' "$(json_escape "$source")" || printf null)" \
                "$([ -n "$gateway" ] && [ "$gateway" != ' ' ] && printf '"%s"' "$(json_escape "$gateway")" || printf null)" \
                "${private_table:-null}" "$([ -n "$endpoint" ] && [ "$endpoint" != ' ' ] && printf '"%s"' "$(json_escape "$endpoint")" || printf null)" \
                "$(json_escape "${probe_reason:-$reason}")" "${failures:-0}" "$next"
        done < "$CANDIDATE_FILE"
        printf ']}\n'
    } > "$ttmp" && mv "$ttmp" "$TELEMETRY_FILE"
}

acquire_eval_lock()
{
    if mkdir "$LOCK_DIR" 2>/dev/null; then printf '%s\n' "$$" > "$LOCK_DIR/pid"; return 0; fi
    oldpid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    case "$oldpid" in ''|*[!0-9]*) ;; *) kill -0 "$oldpid" 2>/dev/null && return 1 ;; esac
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null || return 1
    printf '%s\n' "$$" > "$LOCK_DIR/pid"
}

evaluate_once()
{
    [ -e "$INHIBIT_FILE" ] && return 0
    acquire_eval_lock || return 3
    if [ -e "$INHIBIT_FILE" ]; then
        rm -rf "$LOCK_DIR"
        return 0
    fi
    trap 'rm -rf "$LOCK_DIR"' EXIT HUP INT TERM

    /usr/local/bin/wan-tunnel-guard apply >/dev/null 2>&1 || true
    [ -r "$CANDIDATE_FILE" ] && cp "$CANDIDATE_FILE" "$CANDIDATE_FILE.last" 2>/dev/null || true
    : > "$CANDIDATE_FILE"

    mode="$(uci_get selection_mode)"
    case "$mode" in
        ordered) ;;
        *)
            mode=ordered
            uci -c /etc/config.mesh -q set "$CONFIG_PACKAGE.$CONFIG_SECTION.selection_mode=ordered"
            uci -c /etc/config.mesh -q commit "$CONFIG_PACKAGE"
            ;;
    esac
    if [ "$(uci_get enabled)" != 1 ]; then
        if package_has_effects; then
            /usr/local/bin/wan-port-manager disable >/dev/null 2>&1 || true
            /usr/local/bin/wan3-manager disable >/dev/null 2>&1 || true
            /usr/local/bin/wan-tunnel-guard remove >/dev/null 2>&1 || true
            message='controller disabled; package-created network state removed and WAN 1 restored'
        else
            message='controller disabled; installation is inert and ordinary AREDN networking is unchanged'
        fi
        : > "$CANDIDATE_FILE"
        write_status "$mode" "$(uci_get active)" "$(uci_get active_bin)" "$message"
        rm -rf "$LOCK_DIR"; trap - EXIT HUP INT TERM
        return 0
    fi

    WAN1_TRANSPORT="$(/usr/local/bin/wan-port-manager wan-transport 2>/dev/null)"
    if [ $? -ne 0 ]; then
        /usr/local/bin/wan3-manager withdraw 'Both AREDN radios are configured as WAN clients' 1 >/dev/null 2>&1 || true
        : > "$CANDIDATE_FILE"
        write_status "$mode" "$(uci_get active)" none 'invalid AREDN radio configuration: both radios are WAN clients'
        rm -rf "$LOCK_DIR"; trap - EXIT HUP INT TERM
        return 1
    fi

    /usr/local/bin/wan3-manager usb-apply >/dev/null 2>&1 || true
    /usr/local/bin/wan-route-cache all >/dev/null 2>&1 || true

    minimum="$(uci_get selection_min_bin)"; case "$minimum" in low|medium|fast) ;; *) minimum=unknown ;; esac
    min_score="$(class_score "$minimum")"
    result_ttl="$(number_setting speed_result_ttl 21600 900 86400)"
    calibration_interval="$(number_setting speed_test_interval 21600 900 86400)"
    # Never let a configured refresh interval exceed result lifetime; direct
    # UCI edits must not create a long window with every class stale.
    [ "$calibration_interval" -le "$result_ttl" ] || calibration_interval="$result_ttl"
    failure_limit="$(number_setting failure_count 2 1 10)"
    promote_count="$(number_setting promote_count 2 1 10)"
    hold_down="$(number_setting hold_down 120 0 3600)"

    for name in wan wan2 wan3; do
        evaluate_candidate "$name" "$mode" "$min_score" "$result_ttl" "$calibration_interval" "$failure_limit" >> "$CANDIDATE_FILE"
    done
    evaluate_mesh_candidate >> "$CANDIDATE_FILE"

    active="$(uci_get active)"; case "$active" in wan|wan2|wan3|mesh|none) ;; *) active=wan ;; esac
    chosen="$(choose_candidate)"
    old_ifs="$IFS"; IFS='|'; set -- $chosen; IFS="$old_ifs"
    best="$1"

    active_line="$(read_active_line "$active")"
    active_healthy=0; active_score=0; active_bin=unknown; active_upstream=0
    if [ -n "$active_line" ]; then
        old_ifs="$IFS"; IFS='|'; set -- $active_line; IFS="$old_ifs"
        active_upstream="${6:-0}"
        active_healthy="${7:-0}"
        active_bin="${9:-unknown}"
        active_score="${10:-0}"
    fi
    export_count="$(number_setting mesh_export_recover_count 3 1 10)"
    export_hold="$(number_setting mesh_export_hold_down 60 0 3600)"
    if [ "$active_upstream" != 1 ]; then
        if ip -4 route show table 28 default 2>/dev/null | grep -q '^default'; then set_export_change_now; fi
        reset_export_recovery
    fi

    message='status only'
    if [ -z "$best" ]; then
        /usr/local/bin/wan3-manager withdraw 'No enabled route meets availability and data-rate policy' 1 >/dev/null 2>&1 || true
        active="$(uci_get active)"; active_bin=none
        message='no enabled route is currently eligible'
        reset_promotion
    elif [ "$active" = none ] || [ "$active_healthy" != 1 ] || [ "$active_score" -eq 0 ]; then
        if switch_to "$best" >/dev/null 2>&1; then
            active="$(uci_get active)"
            new_line="$(read_active_line "$active")"
            [ -n "$new_line" ] && active_bin="$(printf '%s' "$new_line" | awk -F'|' '{print $9}')" || active_bin=none
            message="hard failure or ineligible path: selected $active immediately"
        else
            /usr/local/bin/wan3-manager withdraw 'Immediate fallback candidate failed' 1 >/dev/null 2>&1 || true
            active="$(uci_get active)"; active_bin=none
            message='fallback candidate failed; local defaults withdrawn'
        fi
    elif [ "$best" = "$active" ]; then
        if [ "$active" = mesh ]; then
            /usr/local/bin/wan3-manager withdraw 'Remote Mesh WAN remains the highest-priority available route' 0 >/dev/null 2>&1 || true
            message='Remote Mesh WAN remains the highest-priority available route'
        else
            export_ok=0
            [ "$active_upstream" = 1 ] && export_recovery_ready "$active" "$export_count" "$export_hold" && export_ok=1
            /usr/local/bin/wan3-manager select "$active" 0 "$active_bin" "$export_ok" >/dev/null 2>&1 || true
            message="$active remains the highest-priority eligible route"
        fi
        reset_promotion
    else
        best_rank="$(candidate_rank "$best")"
        active_rank="$(candidate_rank "$active")"
        should_promote=0
        [ "$best_rank" -lt "$active_rank" ] && should_promote=1
        last_switch="$(cat "$SWITCH_FILE" 2>/dev/null || true)"; valid_uint "$last_switch" || last_switch=0
        now="$(date +%s)"
        if [ "$should_promote" = 1 ] && [ $((now - last_switch)) -ge "$hold_down" ]; then
            if promotion_ready "$best" "$promote_count"; then
                if switch_to "$best" >/dev/null 2>&1; then
                    active="$(uci_get active)"
                    message="promoted $active after $promote_count consecutive observations"
                else
                    message="$best passed promotion but route installation failed; $active retained"
                fi
            else
                message="$best is the recovered higher-priority route; waiting for recovery confirmation"
            fi
        else
            message="$active retained until a higher-priority route is confirmed available"
            reset_promotion
        fi
    fi

    active="$(uci_get active)"
    active_line="$(read_active_line "$active")"
    if [ -n "$active_line" ]; then active_bin="$(printf '%s' "$active_line" | awk -F'|' '{print $9}')"; else active_bin=none; fi
    write_status "$mode" "$active" "$active_bin" "$message"
    rm -rf "$LOCK_DIR"
    trap - EXIT HUP INT TERM
}

daemon_loop()
{
    while [ "$(uci_get enabled)" = 1 ]; do
        [ -e "$INHIBIT_FILE" ] || evaluate_once || true
        interval="$(number_setting standby_health_interval 90 10 3600)"
        for file in "$STATE_DIR"/next-probe.*; do
            [ -e "$file" ] || continue
            next="$(cat "$file" 2>/dev/null || true)"
            valid_uint "$next" || continue
            now="$(date +%s)"
            wait=$((next - now))
            [ "$wait" -lt 1 ] && wait=1
            [ "$wait" -lt "$interval" ] && interval="$wait"
        done
        sleep "$interval"
    done
    evaluate_once || true
}

case "${1:-once}" in
    once|evaluate) MANUAL_CHECK=1; evaluate_once ;;
    daemon) daemon_loop ;;
    status) [ -r "$STATUS_FILE" ] && cat "$STATUS_FILE" || printf '{"status":"unknown"}\n' ;;
    *) echo "usage: $0 {once|daemon|status}" >&2; exit 2 ;;
esac
