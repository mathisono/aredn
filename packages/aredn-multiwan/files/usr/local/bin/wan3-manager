#!/bin/sh
# Manage the selected local WAN, AREDN policy tables, USB wan3, and safe
# withdrawal to a remote Mesh WAN when no local path is eligible.

set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C

STATE_DIR=/tmp/wan3
STATE_FILE="$STATE_DIR/state.json"
LAN_RULE_FILE="$STATE_DIR/lan-rule-device"
MANAGER_LOCK="$STATE_DIR/.manager.lock"
CONFIG_PACKAGE=aredn
CONFIG_SECTION=multiwan

# AREDN owns 20/21/22/23/27/28/29/99 while PollyWAN is disabled. While
# PollyWAN is enabled it temporarily suspends the stock WAN monitor and owns
# only the default-like routes in table 28. This keeps the APK compatible with
# stock AREDN main/nightly firmware without replacing firmware files.
LOCAL_TABLE=26
LOCAL_SUBNET_TABLE=27
REMOTE_MESH_TABLE=22
LOCAL_DTD_DEFAULT_TABLE=23
BABEL_EXPORT_TABLE=28
LOCAL_RULE_PREF=145
LAN_RULE_PREF=44
EXPORT_CHANGE_FILE=/tmp/wan-sla/last-export-change
EXPORT_HEARTBEAT_FILE=/tmp/wan3/export-heartbeat

mkdir -p "$STATE_DIR" || exit 1

log()
{
    logger -t aredn-multiwan "$*"
}

monotonic_seconds()
{
    awk '{ sub(/\..*/, "", $1); print $1 }' /proc/uptime 2>/dev/null
}

restart_native_monitor()
{
    mkdir -p /tmp/mgr >/dev/null 2>&1 || true
    touch /tmp/mgr/wan_monitor >/dev/null 2>&1 || true
    pid="$(pidof manager 2>/dev/null | awk '{ print $1 }')"
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    kill -USR1 "$pid" >/dev/null 2>&1 || true
}

native_monitor_takeover()
{
    [ "$(uci_get enabled)" = 1 ] || return 1
    changed=0
    if [ "$(uci_get native_monitor_takeover)" != 1 ]; then
        for number in 1 2; do
            option="monitor$number"
            if value="$(uci -c /etc/config.mesh -q get "aredn.@wan[0].$option" 2>/dev/null)"; then
                uci -c /etc/config.mesh set "aredn.multiwan.native_${option}_present=1" || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
                uci -c /etc/config.mesh set "aredn.multiwan.native_${option}_saved=$value" || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
            else
                uci -c /etc/config.mesh set "aredn.multiwan.native_${option}_present=0" || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
                uci -c /etc/config.mesh -q delete "aredn.multiwan.native_${option}_saved" >/dev/null 2>&1 || true
            fi
        done
        uci -c /etc/config.mesh set aredn.multiwan.native_monitor_takeover=1 || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
        changed=1
    else
        # If an administrator changed a native monitor while PollyWAN was
        # active, preserve that new value for restoration before suppressing
        # the competing task again.
        for number in 1 2; do
            option="monitor$number"
            if value="$(uci -c /etc/config.mesh -q get "aredn.@wan[0].$option" 2>/dev/null)"; then
                uci -c /etc/config.mesh set "aredn.multiwan.native_${option}_present=1" || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
                uci -c /etc/config.mesh set "aredn.multiwan.native_${option}_saved=$value" || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
                changed=1
            fi
        done
    fi

    for number in 1 2; do
        option="monitor$number"
        if uci -c /etc/config.mesh -q get "aredn.@wan[0].$option" >/dev/null 2>&1; then
            uci -c /etc/config.mesh -q delete "aredn.@wan[0].$option" >/dev/null 2>&1 || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
            changed=1
        fi
    done
    if [ "$changed" = 1 ]; then
        uci -c /etc/config.mesh commit aredn || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
        restart_native_monitor
        log "Stock AREDN WAN monitor suspended while PollyWAN owns table 28"
    fi
}

native_monitor_release()
{
    [ "$(uci_get native_monitor_takeover)" = 1 ] || return 0
    for number in 1 2; do
        option="monitor$number"
        present="$(uci_get "native_${option}_present")"
        saved="$(uci_get "native_${option}_saved")"
        # A value that appeared while PollyWAN was active is a later
        # administrator change. Keep it rather than overwriting it with the
        # pre-takeover snapshot during disable or package removal.
        if uci -c /etc/config.mesh -q get "aredn.@wan[0].$option" >/dev/null 2>&1; then
            :
        elif [ "$present" = 1 ]; then
            uci -c /etc/config.mesh set "aredn.@wan[0].$option=$saved" || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
        else
            uci -c /etc/config.mesh -q delete "aredn.@wan[0].$option" >/dev/null 2>&1 || true
        fi
        uci -c /etc/config.mesh -q delete "aredn.multiwan.native_${option}_present" >/dev/null 2>&1 || true
        uci -c /etc/config.mesh -q delete "aredn.multiwan.native_${option}_saved" >/dev/null 2>&1 || true
    done
    uci -c /etc/config.mesh -q delete aredn.multiwan.native_monitor_takeover >/dev/null 2>&1 || true
    uci -c /etc/config.mesh commit aredn || { uci -c /etc/config.mesh revert aredn >/dev/null 2>&1 || true; return 1; }
    restart_native_monitor
    log "Stock AREDN WAN monitor settings restored"
}

uci_get()
{
    uci -c /etc/config.mesh -q get "$CONFIG_PACKAGE.$CONFIG_SECTION.$1" 2>/dev/null || true
}

aredn_wan_get()
{
    uci -c /etc/config.mesh -q get "aredn.@wan[0].$1" 2>/dev/null || true
}

json_escape()
{
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r/\\r/g; s/\n/\\n/g'
}

valid_device()
{
    case "$1" in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; *) return 0 ;; esac
}

valid_ipv4()
{
    printf '%s\n' "$1" | awk -F. '
        NF != 4 { bad = 1 }
        { for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) bad = 1 }
        END { exit bad }
    '
}

connected_prefix_from_cidr()
{
    printf '%s\n' "$1" | awk -F'[./]' '
        NF != 5 { exit 1 }
        {
            for (i = 1; i <= 5; i++) if ($i !~ /^[0-9]+$/) exit 1
            if ($1 > 255 || $2 > 255 || $3 > 255 || $4 > 255 || $5 < 0 || $5 > 32) exit 1
            addr = (($1 * 256 + $2) * 256 + $3) * 256 + $4
            hostbits = 32 - $5
            block = 1
            for (i = 0; i < hostbits; i++) block *= 2
            net = int(addr / block) * block
            o1 = int(net / 16777216); net -= o1 * 16777216
            o2 = int(net / 65536); net -= o2 * 65536
            o3 = int(net / 256); o4 = net - o3 * 256
            printf "%d.%d.%d.%d/%d\n", o1, o2, o3, o4, $5
        }
    '
}

wan_transport_valid()
{
    /usr/local/bin/wan-port-manager wan-transport >/dev/null 2>&1
}

bin_score()
{
    case "$1" in low) echo 1 ;; medium) echo 2 ;; fast) echo 3 ;; *) echo 0 ;; esac
}

acquire_manager_lock()
{
    tries=0
    while ! mkdir "$MANAGER_LOCK" 2>/dev/null; do
        oldpid="$(cat "$MANAGER_LOCK/pid" 2>/dev/null || true)"
        case "$oldpid" in
            ''|*[!0-9]*) rm -rf "$MANAGER_LOCK" ;;
            *)
                if ! kill -0 "$oldpid" 2>/dev/null; then
                    rm -rf "$MANAGER_LOCK"
                else
                    tries=$((tries + 1))
                    [ "$tries" -lt 15 ] || return 1
                    sleep 1
                fi
                ;;
        esac
    done
    printf '%s\n' "$$" > "$MANAGER_LOCK/pid"
}

is_usb_netdev()
{
    dev="$1"
    [ -e "/sys/class/net/$dev" ] || return 1
    case "$dev" in lo|br*|wlan*|phy*|ifb*|wg*|tun*|dtd*) return 1 ;; esac
    target="$(readlink -f "/sys/class/net/$dev/device" 2>/dev/null || true)"
    case "$target" in *'/usb'*|*'/usb'*) return 0 ;; esac
    case "$dev" in usb[0-9]*|rndis[0-9]*|wwan[0-9]*|enx*) return 0 ;; esac
    return 1
}

module_available()
{
    module="$1"
    modinfo "$module" >/dev/null 2>&1 && return 0
    [ -d "/sys/module/$module" ] && return 0
    return 1
}

module_status()
{
    module="$1"
    if [ -d "/sys/module/$module" ]; then
        printf 'built-in\n'
    elif modinfo "$module" >/dev/null 2>&1; then
        printf 'loadable\n'
    else
        printf 'unavailable\n'
    fi
}

usb_support_report()
{
    device="$(detect_device 2>/dev/null || true)"
    reason="WAN3 unavailable: no compatible existing kernel USB-network support"
    available=0
    [ -n "$device" ] && { available=1; reason="USB network device present"; }
    printf 'usbnet=%s\n' "$(module_status usbnet)"
    printf 'cdc_ether=%s\n' "$(module_status cdc_ether)"
    printf 'cdc_ncm=%s\n' "$(module_status cdc_ncm)"
    printf 'rndis_host=%s\n' "$(module_status rndis_host)"
    printf 'network_device=%s\n' "${device:-none}"
    printf 'available=%s\n' "$available"
    printf 'reason=%s\n' "$reason"
}

load_existing_usb_modules()
{
    for module in usbnet cdc_ether cdc_ncm rndis_host; do
        module_available "$module" || continue
        [ -d "/sys/module/$module" ] && continue
        modprobe "$module" >/dev/null 2>&1 || true
    done
}

detect_device()
{
    configured="$(uci_get wan3_device)"
    [ -n "$configured" ] || configured=auto
    if [ "$configured" != auto ]; then
        valid_device "$configured" || return 1
        is_usb_netdev "$configured" || return 1
        printf '%s\n' "$configured"
        return 0
    fi
    for path in /sys/class/net/*; do
        [ -e "$path" ] || continue
        dev="${path##*/}"
        if is_usb_netdev "$dev"; then printf '%s\n' "$dev"; return 0; fi
    done
    return 1
}

remove_dynamic()
{
    if ubus call network.interface.wan3 status >/dev/null 2>&1; then
        ubus call network.interface.wan3 down >/dev/null 2>&1 || true
        ubus call network.interface.wan3 remove >/dev/null 2>&1 || true
        sleep 1
    fi
    /usr/local/bin/wan-route-cache wan3 >/dev/null 2>&1 || true
}

add_dynamic()
{
    device="$1"
    existing="$(ubus call network.interface.wan3 status 2>/dev/null || true)"
    existing_device="$(printf '%s' "$existing" | jsonfilter -e '@.device' 2>/dev/null || true)"
    [ -n "$existing_device" ] || existing_device="$(printf '%s' "$existing" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
    if [ "$existing_device" = "$device" ]; then
        ubus call network.interface.wan3 up >/dev/null 2>&1 || true
        return 0
    fi

    remove_dynamic
    . /usr/share/libubox/jshn.sh
    json_init
    json_add_string name wan3
    json_add_string device "$device"
    json_add_string proto dhcp
    json_add_string zone wan
    json_add_boolean defaultroute 1
    json_add_boolean peerdns 1
    json_add_int dns_metric 1
    json_add_int metric 30
    json_add_string ip4table 103
    ubus call network add_dynamic "$(json_dump)" >/dev/null 2>&1 || return 1
    ubus call network.interface.wan3 up >/dev/null 2>&1 || true
}

private_table()
{
    case "$1" in wan) echo 101 ;; wan2) echo 102 ;; wan3) echo 103 ;; *) return 1 ;; esac
}

interface_values()
{
    name="$1"
    table="$(private_table "$name")" || return 1
    status="$(ubus call "network.interface.$name" status 2>/dev/null)" || return 1
    up="$(printf '%s' "$status" | jsonfilter -e '@.up' 2>/dev/null || true)"
    [ "$up" = true ] || [ "$up" = 1 ] || return 1
    device="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
    source="$(printf '%s' "$status" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || true)"
    mask="$(printf '%s' "$status" | jsonfilter -e '@["ipv4-address"][0].mask' 2>/dev/null || true)"
    valid_device "$device" || return 1
    valid_ipv4 "$source" || return 1

    route="$(ip -4 route show table "$table" default dev "$device" 2>/dev/null | head -n 1 || true)"
    gateway="$(printf '%s\n' "$route" | sed -n 's/.* via \([^ ]*\).*/\1/p')"
    if [ -z "$route" ]; then
        gateway="$(printf '%s' "$status" | jsonfilter -e "@.route[@.target='0.0.0.0'].nexthop" 2>/dev/null | head -n 1 || true)"
        [ -n "$gateway" ] || gateway="$(printf '%s' "$status" | jsonfilter -e "@.inactive.route[@.target='0.0.0.0'].nexthop" 2>/dev/null | head -n 1 || true)"
        target="$(printf '%s' "$status" | jsonfilter -e "@.route[@.target='0.0.0.0'].target" 2>/dev/null | head -n 1 || true)"
        [ -n "$target" ] || target="$(printf '%s' "$status" | jsonfilter -e "@.inactive.route[@.target='0.0.0.0'].target" 2>/dev/null | head -n 1 || true)"
        [ "$target" = 0.0.0.0 ] || return 1
    fi

    network="$(ip -4 route show table all dev "$device" scope link 2>/dev/null | awk -v source="$source" '
        function cidr_prefix(value, parts) {
            return split(value, parts, "/") == 2 && parts[1] ~ /^[0-9.]+$/ && parts[2] ~ /^[0-9]+$/
        }
        cidr_prefix($1) && $0 ~ ("src " source) { print $1; exit }
    ')"
    [ -n "$network" ] || network="$(ip -4 route show table all dev "$device" scope link 2>/dev/null | awk '
        function cidr_prefix(value, parts) {
            return split(value, parts, "/") == 2 && parts[1] ~ /^[0-9.]+$/ && parts[2] ~ /^[0-9]+$/
        }
        cidr_prefix($1) { print $1; exit }
    ')"
    [ -n "$network" ] || network="$(connected_prefix_from_cidr "$source/$mask" 2>/dev/null || true)"
    case "$network" in *.*/*) ;; *) return 1 ;; esac
    printf '%s|%s|%s|%s\n' "$device" "$source" "$gateway" "$network"
}

result_bin()
{
    name="$1"
    result="/tmp/wan-speed/$name.json"
    [ -r "$result" ] || { echo unknown; return; }
    valid="$(jsonfilter -i "$result" -e '@.valid' 2>/dev/null || true)"
    case "$valid" in true|1) ;; *) echo unknown; return ;; esac
    bin="$(jsonfilter -i "$result" -e '@.class' 2>/dev/null || true)"
    case "$bin" in low|medium|fast) echo "$bin" ;; *) echo unknown ;; esac
}

candidate_devices()
{
    for name in wan wan2 wan3; do
        status="$(ubus call "network.interface.$name" status 2>/dev/null || true)"
        dev="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
        valid_device "$dev" && printf '%s\n' "$dev"
    done | sort -u
}

remove_all_main_defaults()
{
    while ip -4 route del table main default >/dev/null 2>&1; do :; done
}

default_route_matches()
{
    table="$1"; device="$2"; source="$3"; gateway="$4"
    line="$(ip -4 route show table "$table" default 2>/dev/null | head -n 1 || true)"
    [ -n "$line" ] || return 1
    printf '%s\n' "$line" | grep -q "dev $device" || return 1
    printf '%s\n' "$line" | grep -q "src $source" || return 1
    if valid_ipv4 "$gateway"; then
        printf '%s\n' "$line" | grep -q " via $gateway " || return 1
    else
        printf '%s\n' "$line" | grep -q ' via ' && return 1
    fi
    return 0
}

connected_route_matches()
{
    table="$1"; network="$2"; device="$3"; source="$4"
    ip -4 route show table "$table" "$network" 2>/dev/null |
        grep -q "^$network dev $device .*src $source"
}

policy_rule_matches()
{
    ip -4 rule show | grep -q "^$LOCAL_RULE_PREF:.*lookup $LOCAL_TABLE"
}

install_default()
{
    table="$1"; device="$2"; source="$3"; gateway="$4"; metric="$5"
    if valid_ipv4 "$gateway"; then
        ip -4 route replace table "$table" default via "$gateway" dev "$device" src "$source" metric "$metric" onlink proto static
    else
        ip -4 route replace table "$table" default dev "$device" src "$source" metric "$metric" proto static
    fi
}

replace_default_if_needed()
{
    table="$1"; device="$2"; source="$3"; gateway="$4"; metric="$5"
    default_route_matches "$table" "$device" "$source" "$gateway" && return 0
    install_default "$table" "$device" "$source" "$gateway" "$metric"
}

replace_connected_if_needed()
{
    table="$1"; network="$2"; device="$3"; source="$4"
    connected_route_matches "$table" "$network" "$device" "$source" && return 0
    ip -4 route replace table "$table" "$network" dev "$device" src "$source" scope link proto static
}

export_route_matches()
{
    prefix="$1"; device="$2"; source="$3"; gateway="$4"
    line="$(ip -4 route show table "$BABEL_EXPORT_TABLE" "$prefix" 2>/dev/null | head -n 1 || true)"
    [ -n "$line" ] || return 1
    case "$prefix" in
        default) printf '%s\n' "$line" | grep -q '^default ' || return 1 ;;
        *) printf '%s\n' "$line" | grep -q "^$prefix " || return 1 ;;
    esac
    printf '%s\n' "$line" | grep -q "dev $device" || return 1
    printf '%s\n' "$line" | grep -q "src $source" || return 1
    if valid_ipv4 "$gateway"; then
        printf '%s\n' "$line" | grep -q " via $gateway " || return 1
    else
        printf '%s\n' "$line" | grep -q ' via ' && return 1
    fi
}

clear_export_routes()
{
    ip -4 route flush table "$BABEL_EXPORT_TABLE" default >/dev/null 2>&1 || true
    ip -4 route flush table "$BABEL_EXPORT_TABLE" 0.0.0.0/1 >/dev/null 2>&1 || true
    ip -4 route flush table "$BABEL_EXPORT_TABLE" 128.0.0.0/1 >/dev/null 2>&1 || true
}

mark_export_change()
{
    mkdir -p "${EXPORT_CHANGE_FILE%/*}" 2>/dev/null || true
    date +%s > "$EXPORT_CHANGE_FILE"
}

refresh_export_heartbeat()
{
    now="$(monotonic_seconds)"
    case "$now" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$now" > "$EXPORT_HEARTBEAT_FILE"
}

withdraw_export_if_needed()
{
    had_export=0
    for prefix in default 0.0.0.0/1 128.0.0.0/1; do
        if ip -4 route show table "$BABEL_EXPORT_TABLE" "$prefix" 2>/dev/null | grep -q .; then
            had_export=1
            break
        fi
    done
    clear_export_routes
    rm -f "$EXPORT_HEARTBEAT_FILE"
    [ "$had_export" = 0 ] || mark_export_change
}

install_export_route()
{
    prefix="$1"; device="$2"; source="$3"; gateway="$4"
    if valid_ipv4 "$gateway"; then
        ip -4 route replace table "$BABEL_EXPORT_TABLE" "$prefix" via "$gateway" dev "$device" src "$source" metric 1 onlink proto static
    else
        ip -4 route replace table "$BABEL_EXPORT_TABLE" "$prefix" dev "$device" src "$source" metric 1 proto static
    fi
}

reconcile_export_routes()
{
    device="$1"; source="$2"; gateway="$3"
    split=0
    [ "$(aredn_wan_get local_defaultroute)" = 1 ] && split=1
    if export_route_matches default "$device" "$source" "$gateway" &&
        { [ "$split" = 0 ] || { export_route_matches 0.0.0.0/1 "$device" "$source" "$gateway" && export_route_matches 128.0.0.0/1 "$device" "$source" "$gateway"; }; } &&
        { [ "$split" = 1 ] || { ! ip -4 route show table "$BABEL_EXPORT_TABLE" 0.0.0.0/1 2>/dev/null | grep -q . && ! ip -4 route show table "$BABEL_EXPORT_TABLE" 128.0.0.0/1 2>/dev/null | grep -q .; }; }
    then
        refresh_export_heartbeat
        return
    fi

    clear_export_routes
    install_export_route default "$device" "$source" "$gateway" || return 1
    if [ "$split" = 1 ]; then
        install_export_route 0.0.0.0/1 "$device" "$source" "$gateway" || return 1
        install_export_route 128.0.0.0/1 "$device" "$source" "$gateway" || return 1
    fi
    refresh_export_heartbeat || return 1
    mark_export_change
}

logical_device()
{
    status="$(ubus call "network.interface.$1" status 2>/dev/null || true)"
    dev="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
    [ -n "$dev" ] || dev="$(printf '%s' "$status" | jsonfilter -e '@.device' 2>/dev/null || true)"
    valid_device "$dev" && printf '%s\n' "$dev"
}

ensure_policy_rules()
{
    policy_rule_matches || ip -4 rule add pref "$LOCAL_RULE_PREF" lookup "$LOCAL_TABLE" >/dev/null 2>&1 || true

    if [ -r "$LAN_RULE_FILE" ]; then
        old="$(cat "$LAN_RULE_FILE" 2>/dev/null || true)"
        if valid_device "$old"; then
            while ip -4 rule del pref "$LAN_RULE_PREF" iif "$old" lookup "$LOCAL_TABLE" >/dev/null 2>&1; do :; done
        fi
    fi
    rm -f "$LAN_RULE_FILE"

    if [ "$(aredn_wan_get lan_dhcp_route)" = 1 ]; then
        lan_device="$(logical_device lan || true)"
        if valid_device "$lan_device"; then
            ip -4 rule show | grep -q "^$LAN_RULE_PREF:.*iif $lan_device .*lookup $LOCAL_TABLE" || ip -4 rule add pref "$LAN_RULE_PREF" iif "$lan_device" lookup "$LOCAL_TABLE" >/dev/null 2>&1 || true
            printf '%s\n' "$lan_device" > "$LAN_RULE_FILE"
        fi
    fi
}

remove_policy_rules()
{
    while ip -4 rule del pref "$LOCAL_RULE_PREF" lookup "$LOCAL_TABLE" >/dev/null 2>&1; do :; done
    if [ -r "$LAN_RULE_FILE" ]; then
        old="$(cat "$LAN_RULE_FILE" 2>/dev/null || true)"
        if valid_device "$old"; then
            while ip -4 rule del pref "$LAN_RULE_PREF" iif "$old" lookup "$LOCAL_TABLE" >/dev/null 2>&1; do :; done
        fi
    fi
    rm -f "$LAN_RULE_FILE"
}

mesh_share_eligible()
{
    bin="$1"; healthy="$2"
    [ "$healthy" = 1 ] || return 1
    [ "$(aredn_wan_get mesh_to_local_wan)" = 1 ] || return 1
    minimum="$(uci_get mesh_share_min_bin)"
    case "$minimum" in low|medium|fast) ;; *) minimum=medium ;; esac
    [ "$(bin_score "$bin")" -ge "$(bin_score "$minimum")" ]
}

write_state()
{
    status="$1"; active="$2"; device="$3"; bin="$4"; shared="$5"; message="$6"
    remote=0
    dtd=0
    ip -4 route show table "$REMOTE_MESH_TABLE" default | grep -q '^default' && remote=1
    ip -4 route show table "$LOCAL_DTD_DEFAULT_TABLE" default | grep -q '^default' && dtd=1
    tmp="$STATE_FILE.tmp.$$"
    printf '{"status":"%s","active":"%s","device":"%s","bin":"%s","mesh_shared":%s,"remote_mesh_default":%s,"local_dtd_default":%s,"message":"%s","time":"%s"}\n' \
        "$(json_escape "$status")" "$(json_escape "$active")" "$(json_escape "$device")" "$(json_escape "$bin")" \
        "$shared" "$remote" "$dtd" "$(json_escape "$message")" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

persist_active()
{
    active="$1"; bin="$2"
    uci -c /etc/config.mesh set "$CONFIG_PACKAGE.$CONFIG_SECTION.active=$active"
    uci -c /etc/config.mesh set "$CONFIG_PACKAGE.$CONFIG_SECTION.active_bin=$bin"
    uci -c /etc/config.mesh commit "$CONFIG_PACKAGE"
}

snapshot_routes()
{
    dir="$1"
    mkdir -p "$dir" || return 1
    ip -4 route show table main default > "$dir/main" 2>/dev/null || :
    ip -4 route show table "$LOCAL_TABLE" > "$dir/26" 2>/dev/null || :
    ip -4 route show table "$LOCAL_SUBNET_TABLE" > "$dir/27" 2>/dev/null || :
    ip -4 route show table "$BABEL_EXPORT_TABLE" | awk '$1 == "default" || $1 == "0.0.0.0/1" || $1 == "128.0.0.0/1"' > "$dir/28" 2>/dev/null || :
}

restore_table_file()
{
    table="$1"; file="$2"
    if [ "$table" = main ]; then remove_all_main_defaults; else ip -4 route flush table "$table" >/dev/null 2>&1 || true; fi
    [ -r "$file" ] || return 0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        # Route tokens originate from the kernel, not request input.
        ip -4 route add table "$table" $line >/dev/null 2>&1 || true
    done < "$file"
}

restore_route_snapshot()
{
    dir="$1"
    restore_table_file main "$dir/main"
    restore_table_file "$LOCAL_TABLE" "$dir/26"
    restore_table_file "$LOCAL_SUBNET_TABLE" "$dir/27"
    clear_export_routes
    if [ -r "$dir/28" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            ip -4 route add table "$BABEL_EXPORT_TABLE" $line >/dev/null 2>&1 || true
        done < "$dir/28"
    fi
}

select_wan()
{
    selected="$1"; persist="${2:-1}"; bin="${3:-unknown}"; healthy="${4:-1}"
    case "$selected" in wan|wan2|wan3) ;; *) return 2 ;; esac
    native_monitor_takeover || return 1
    if [ "$selected" = wan ]; then
        wan_transport_valid || { write_state error "$(uci_get active)" "" unknown 0 'Both AREDN radios are configured as WAN clients'; return 1; }
    fi
    if [ "$selected" != wan ] && [ "$(uci_get enabled)" != 1 ]; then return 1; fi
    [ "$selected" = wan3 ] && apply_usb >/dev/null 2>&1 || true

    /usr/local/bin/wan-route-cache "$selected" >/dev/null 2>&1 || true
    values="$(interface_values "$selected")" || return 1
    old_ifs="$IFS"; IFS='|'; set -- $values; IFS="$old_ifs"
    device="$1"; source="$2"; gateway="${3:-}"; network="$4"

    previous="$(uci_get active)"
    snapshot="$STATE_DIR/route-snapshot.$$"
    snapshot_routes "$snapshot" || return 1

    ensure_policy_rules

    failed=0
    replace_default_if_needed "$LOCAL_TABLE" "$device" "$source" "$gateway" 1 || failed=1
    [ "$failed" = 1 ] || replace_connected_if_needed "$LOCAL_SUBNET_TABLE" "$network" "$device" "$source" || failed=1
    [ "$failed" = 1 ] || replace_default_if_needed main "$device" "$source" "$gateway" 1 || failed=1

    shared=0
    want_shared=0
    mesh_share_eligible "$bin" "$healthy" && want_shared=1

    if [ "$failed" = 0 ] && [ "$want_shared" = 1 ]; then
        reconcile_export_routes "$device" "$source" "$gateway" || failed=1
        [ "$failed" = 1 ] || shared=1
    elif [ "$failed" = 0 ]; then
        withdraw_export_if_needed || failed=1
    fi

    if [ "$failed" = 1 ]; then
        restore_route_snapshot "$snapshot"
        rm -rf "$snapshot"
        write_state error "$previous" "" unknown 0 "Selection of $selected failed; previous route state restored"
        return 1
    fi

    rm -rf "$snapshot"
    /usr/local/bin/wan-tunnel-guard apply >/dev/null 2>&1 || true
    [ "$persist" = 1 ] && persist_active "$selected" "$bin"
    write_state ready "$selected" "$device" "$bin" "$shared" "$selected selected; PollyWAN owns table 28 while enabled and publishes only a qualified route"
    log "$selected selected (bin=$bin, mesh_shared=$shared)"
}

withdraw_local()
{
    reason="${1:-No eligible local WAN}"; persist="${2:-1}"
    native_monitor_takeover || return 1
    ensure_policy_rules
    remove_all_main_defaults
    ip -4 route flush table "$LOCAL_TABLE" >/dev/null 2>&1 || true
    ip -4 route flush table "$LOCAL_SUBNET_TABLE" >/dev/null 2>&1 || true
    withdraw_export_if_needed >/dev/null 2>&1 || true
    /usr/local/bin/wan-tunnel-guard apply >/dev/null 2>&1 || true
    if ip -4 route show table "$REMOTE_MESH_TABLE" default | grep -q '^default'; then
        active=mesh
        message="$reason; local defaults withdrawn and AREDN table 22 remote Mesh WAN is available"
    elif ip -4 route show table "$LOCAL_DTD_DEFAULT_TABLE" default | grep -q '^default'; then
        active=mesh
        message="$reason; local defaults withdrawn and AREDN table 23 local DtD default is available"
    else
        active=none
        message="$reason; no remote Mesh WAN is currently available"
    fi
    [ "$persist" = 1 ] && persist_active "$active" none
    write_state degraded "$active" "" none 0 "$message"
    log "$message"
}

restore_stock()
{
    remove_policy_rules
    ip -4 route flush table "$LOCAL_TABLE" >/dev/null 2>&1 || true
    withdraw_export_if_needed >/dev/null 2>&1 || true

    /usr/local/bin/wan-route-cache wan >/dev/null 2>&1 || true
    values="$(interface_values wan 2>/dev/null || true)"
    if [ -n "$values" ]; then
        old_ifs="$IFS"; IFS='|'; set -- $values; IFS="$old_ifs"
        device="$1"; source="$2"; gateway="${3:-}"; network="$4"
        remove_all_main_defaults
        ip -4 route flush table "$LOCAL_SUBNET_TABLE" >/dev/null 2>&1 || true
        ip -4 route replace table "$LOCAL_SUBNET_TABLE" "$network" dev "$device" src "$source" scope link proto static >/dev/null 2>&1 || true
        install_default main "$device" "$source" "$gateway" 1 >/dev/null 2>&1 || true
        install_export_route default "$device" "$source" "$gateway" >/dev/null 2>&1 || true
        if [ "$(aredn_wan_get local_defaultroute)" = 1 ]; then
            install_export_route 0.0.0.0/1 "$device" "$source" "$gateway" >/dev/null 2>&1 || true
            install_export_route 128.0.0.0/1 "$device" "$source" "$gateway" >/dev/null 2>&1 || true
        fi
        persist_active wan "$(result_bin wan)"
        write_state disabled wan "$device" "$(result_bin wan)" 0 "Controller disabled; restored ordinary WAN 1 routing"
    else
        remove_all_main_defaults
        ip -4 route flush table "$LOCAL_SUBNET_TABLE" >/dev/null 2>&1 || true
        if ip -4 route show table "$REMOTE_MESH_TABLE" default | grep -q '^default'; then active=mesh; else active=none; fi
        persist_active "$active" none
        write_state degraded "$active" "" none 0 "Controller disabled and WAN 1 is unavailable"
    fi
    /usr/local/bin/wan-route-cache remove >/dev/null 2>&1 || true

    if [ "$(uci_get enabled)" = 1 ]; then
        # Hard package policy while PollyWAN is enabled: tunnels retain mesh
        # routes but never use a local or remote Internet default.
        /usr/local/bin/wan-tunnel-guard apply >/dev/null 2>&1 || true
    else
        /usr/local/bin/wan-tunnel-guard remove >/dev/null 2>&1 || true
    fi
}

disable_package()
{
    remove_dynamic
    withdraw_export_if_needed >/dev/null 2>&1 || true
    restore_stock
    native_monitor_release
    /usr/local/bin/wan-route-cache remove >/dev/null 2>&1 || true
    /usr/local/bin/wan-tunnel-guard remove >/dev/null 2>&1 || true
    write_state disabled wan "$(logical_device wan 2>/dev/null || true)" "$(result_bin wan)" 0 "PollyWAN disabled; ordinary AREDN WAN routing retained"
}

apply_usb()
{
    if [ "$(uci_get enabled)" != 1 ] || [ "$(uci_get wan3_enable)" != 1 ]; then remove_dynamic; return 0; fi
    device="$(detect_device 2>/dev/null || true)"
    if [ -z "$device" ]; then
        load_existing_usb_modules
        device="$(detect_device 2>/dev/null || true)"
    fi
    if [ -z "$device" ]; then
        remove_dynamic
        write_state degraded wan3 "" unknown 0 "WAN3 unavailable: no compatible existing kernel USB-network support"
        return 0
    fi
    add_dynamic "$device"
}

apply()
{
    if [ "$(uci_get enabled)" != 1 ]; then
        write_state disabled "$(uci_get active)" "" unknown 0 "PollyWAN is disabled; no package network changes were applied"
        return 0
    fi

    native_monitor_takeover || return 1

    if ! wan_transport_valid; then
        withdraw_local 'Both AREDN radios are configured as WAN clients' 1
        return 1
    fi

    /usr/local/bin/wan-port-manager reconcile >/dev/null 2>&1 || true
    apply_usb || true
    /usr/local/bin/wan-route-cache all >/dev/null 2>&1 || true
    ensure_policy_rules
    /usr/local/bin/wan-tunnel-guard apply >/dev/null 2>&1 || true

    mode="$(uci_get selection_mode)"; [ -n "$mode" ] || mode=manual
    active="$(uci_get active)"; case "$active" in wan|wan2|wan3) ;; *) active=wan ;; esac
    if [ "$mode" = manual ]; then
        # Route immediately for local management, but do not publish table 28
        # until the SLA evaluator confirms current health and a fresh bin.
        if ! select_wan "$active" 1 unknown 0; then
            withdraw_local "Manual selection is unavailable" 1
        fi
    fi
    /usr/local/bin/wan-sla once >/dev/null 2>&1 &
}

route_event()
{
    changed="${1:-}"; action="${2:-}"
    case "$changed" in wan|wan2|wan3) ;; *) return 0 ;; esac
    [ "$(uci_get enabled)" = 1 ] || return 0
    native_monitor_takeover || return 1
    /usr/local/bin/wan-route-cache "$changed" >/dev/null 2>&1 || true

    # The stock hotplug handler runs first and may briefly repopulate table 28.
    # Remove those default-like routes before asynchronously requalifying the
    # changed interface.
    withdraw_export_if_needed >/dev/null 2>&1 || true

    case "$action" in
        ifup|ifupdate|up|update)
            status="$(ubus call "network.interface.$changed" status 2>/dev/null || true)"
            dev="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
            if valid_device "$dev"; then
                active="$(uci_get active)"
                [ "$changed" = "$active" ] || while ip -4 route del table main default dev "$dev" >/dev/null 2>&1; do :; done
            fi
            ;;
    esac
    /usr/local/bin/wan-sla once >/dev/null 2>&1 &
}

status()
{
    if [ -r "$STATE_FILE" ]; then cat "$STATE_FILE"; else write_state unknown "$(uci_get active)" "" unknown 0 "No Multi-WAN state is available"; cat "$STATE_FILE"; fi
}

COMMAND="${1:-apply}"
if [ "$COMMAND" != status ] && [ "$COMMAND" != inspect ] && [ "$COMMAND" != usb-support ]; then
    if ! acquire_manager_lock; then log "Another WAN manager operation is running"; exit 3; fi
    trap 'rm -rf "$MANAGER_LOCK"' EXIT HUP INT TERM
fi

case "$COMMAND" in
    apply) apply ;;
    usb-apply) apply_usb ;;
    select)
        [ $# -ge 2 ] || exit 2
        select_wan "$2" "${3:-1}" "${4:-unknown}" "${5:-1}"
        ;;
    withdraw) withdraw_local "${2:-No eligible local WAN}" "${3:-1}" ;;
    restore) remove_dynamic; restore_stock ;;
    remove|stop|disable) disable_package ;;
    route-event) route_event "${2:-}" "${3:-}" ;;
    inspect) [ $# -eq 2 ] || exit 2; interface_values "$2" ;;
    usb-support) usb_support_report ;;
    takeover) native_monitor_takeover ;;
    export-withdraw) withdraw_export_if_needed ;;
    status) status ;;
    *) echo "usage: $0 {apply|usb-apply|select WAN [PERSIST BIN HEALTHY]|withdraw [REASON]|restore|disable|route-event IFACE ACTION|inspect WAN|usb-support|takeover|export-withdraw|status}" >&2; exit 2 ;;
esac
